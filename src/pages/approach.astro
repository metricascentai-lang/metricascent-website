---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { title: 'Discover', text: 'We sit with how the work actually moves today: who does what, where it waits, and where money or time leaks. We read your real documents, not a requirements template.', out: 'A plain-language map of your process.' },
  { title: 'Mock-up', text: 'Before any commitment to build, you get a clickable version of your system with sample data. You open it, press the buttons and tell us what is wrong.', out: 'A demo you can click through and share.' },
  { title: 'Build', text: 'We build one complete job end to end, then the next, so something useful works early. Automated tests and access rules go in from the first day.', out: 'Working software, one job at a time.' },
  { title: 'Launch', text: 'Go-live is rehearsed on a test copy first, using your real master data, so the switch itself is uneventful.', out: 'Your team on the live system.' },
  { title: 'Improve', text: 'A business changes, and its system should change with it. We keep adding and adjusting as you learn what you need.', out: 'A system that keeps fitting.' },
];

const principles = [
  { title: 'Software prepares. A person decides.', text: 'The system reads documents, drafts messages, checks rules and flags problems. It does not send, approve, release or pay. A named person does that, every time.' },
  { title: 'Rules live in the database.', text: 'A rule that only exists on a screen can be bypassed. We enforce business rules at the lowest level, where no code path can route around them.' },
  { title: 'Access is locked by role.', text: 'People see what their job needs and nothing else. Sensitive systems use two-factor sign-in, and consequential actions are recorded with who, what and when.' },
  { title: 'Evidence over confidence.', text: 'When the system suggests something, it shows why: the source document, the quote, the number it used. You never have to take its word.' },
  { title: 'You own it.', text: 'The code and the data are yours. The system is built for your business alone.' },
  { title: 'We say where things stand.', text: 'A demo is called a demo. Sample data is labelled sample data. You will always know what is finished and what is not.' },
];

const faqs = [
  { q: 'Do you sell a product, or build custom?', a: 'Custom. Every system on our work page was built for one business and how it actually operates. We reuse what we have learned, not a template.' },
  { q: 'Will the AI act on its own?', a: 'No. Our systems prepare the work and wait for a person. Nothing is sent, approved or paid automatically.' },
  { q: 'Do we have to replace the tools we already use?', a: 'Not necessarily. A system can sit alongside what already works, such as your accounting software, and take over only the parts that are spreadsheets, inboxes and memory today.' },
  { q: 'What do we see before we commit?', a: 'A clickable mock-up of your system with sample data. You judge it by using it, not by reading a proposal.' },
  { q: 'How do we start?', a: 'With a 20-minute call. Tell us how your business runs and where it hurts. If we can help, the next step is the mock-up.' },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base
  title="Our approach: how we build custom AI systems"
  description="How MetricAscent builds custom AI operations systems: discover, mock-up, build, launch, improve. Software prepares and a person decides."
>
  <PageHero eyebrow="Our approach">
    <Fragment slot="title">You see it <em>before you commit to it.</em></Fragment>
    <Fragment slot="lede">We start with how your business really runs, show you a clickable version of the system, and only then build. The software prepares the work. Your people make the decisions.</Fragment>
    <nav slot="aside" class="glass jump" aria-label="The five steps">
      <p class="label">Five steps, in this order</p>
      <ol>
        {steps.map((s, i) => (
          <li><a href={`#${slug(s.title)}`}><span>{num(i)}</span>{s.title}<Icon name="arrow-right" /></a></li>
        ))}
      </ol>
    </nav>
  </PageHero>

  <section class="sec">
    <div class="wrap proc">
      <div class="proc-side">
        <p class="eyebrow">The process</p>
        <h2>Five steps, <em>in this order.</em></h2>
        <p class="proc-now" aria-hidden="true"><b data-now>01</b> / {num(steps.length - 1)}</p>
      </div>
      <ol class="psteps" data-psteps>
        {steps.map((s, i) => (
          <li id={slug(s.title)}>
            <span class="p-n" aria-hidden="true">{num(i)}</span>
            <div class="p-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <p class="p-out"><span class="label">You get</span>{s.out}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec sec-dark">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">Principles</p>
          <h2>How every system we build <em>behaves.</em></h2>
        </div>
        <p>Six rules we hold ourselves to. They are the reason an owner can trust the system with real work.</p>
      </div>
      <ol class="rows">
        {principles.map((p, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec sec-paper">
    <div class="wrap faq-wrap">
      <div class="faq-side" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2>Straight <em>answers.</em></h2>
      </div>
      <div class="faqs" data-reveal>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Light up each step as it reaches the middle of the screen, and keep the counter in step.
  const list = document.querySelector<HTMLElement>('[data-psteps]');
  const now = document.querySelector<HTMLElement>('[data-now]');
  if (list && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(list.children) as HTMLElement[];
    list.classList.add('armed');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const i = items.indexOf(e.target as HTMLElement);
        items.forEach((li, n) => li.classList.toggle('on', n <= i));
        if (now) now.textContent = String(i + 1).padStart(2, '0');
      }
    }, { rootMargin: '-45% 0px -45% 0px' });
    items.forEach((li) => io.observe(li));
    items[0].classList.add('on');
  }
</script>

<style>
  .jump ol { display: grid; margin-top: 12px; }
  .jump a { display: grid; grid-template-columns: 34px 1fr 18px; align-items: center; padding-block: 12px; border-top: 1px solid rgba(255, 255, 255, 0.1); text-decoration: none; color: #fff; font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.015em; transition: padding 0.35s var(--ease), color 0.25s ease; }
  .jump a span { font-family: var(--font-head); font-size: 12px; font-weight: 650; letter-spacing: 0.1em; color: var(--gold-light); font-variant-numeric: tabular-nums; }
  .jump a :global(svg) { width: 16px; height: 16px; color: #8fa2b7; transition: transform 0.3s ease, color 0.25s ease; }
  .jump a:hover { padding-left: 8px; }
  .jump a:hover :global(svg) { transform: translateX(3px); color: var(--gold-light); }

  .proc, .faq-wrap { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); row-gap: 32px; align-items: start; }
  .proc-side, .faq-side { grid-column: 1 / 6; }
  .psteps, .faqs { grid-column: 7 / -1; }
  .proc-side { position: sticky; top: 128px; }
  .proc-side h2 { margin-top: 18px; }
  .proc-now { margin-top: 28px; font-family: var(--font-head); font-size: 13px; font-weight: 600; letter-spacing: 0.12em; color: var(--slate-light); font-variant-numeric: tabular-nums; }
  .proc-now b { font-family: var(--font-display); font-style: italic; font-weight: 420; font-size: 2.4rem; letter-spacing: -0.03em; color: #8a6c14; margin-right: 6px; }
  .psteps { display: grid; border-top: 1px solid var(--line); }
  .psteps li { display: grid; grid-template-columns: clamp(56px, 5.6vw, 78px) minmax(0, 1fr); gap: clamp(14px, 1.8vw, 24px); padding-block: clamp(22px, 2.8vw, 36px); border-bottom: 1px solid var(--line); scroll-margin-top: 110px; }
  .p-n { font-family: var(--font-display); font-size: clamp(2.3rem, 3.6vw, 3rem); font-weight: 400; line-height: 0.86; letter-spacing: -0.04em; color: #8a6c14; font-variant-numeric: lining-nums; transition: color 0.6s ease, opacity 0.6s ease; }
  .p-body h3 { font-family: var(--font-display); font-weight: 480; font-size: var(--d-md); letter-spacing: -0.028em; line-height: 1.05; }
  .p-body > p { margin-top: 12px; color: var(--slate); max-width: 56ch; transition: opacity 0.6s ease; }
  .p-out { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; padding-top: 16px; border-top: 1px dashed #d9dee5; color: var(--navy-700) !important; font-weight: 500; }
  .psteps.armed li:not(.on) .p-n { color: #d5dbe3; }
  .psteps.armed li:not(.on) .p-body { opacity: 0.45; }
  .psteps.armed .p-body { transition: opacity 0.6s ease; }

  .faq-side { position: sticky; top: 128px; }
  .faq-side h2 { margin-top: 18px; }
  .faqs { display: grid; border-top: 1px solid #e3ddcf; }
  details { border-bottom: 1px solid #e3ddcf; }
  summary { list-style: none; cursor: pointer; padding: 17px 0; font-family: var(--font-display); font-weight: 480; font-size: var(--d-sm); letter-spacing: -0.02em; line-height: 1.2; color: var(--navy-700); display: flex; justify-content: space-between; gap: 20px; align-items: center; }
  summary::-webkit-details-marker { display: none; }
  .plus { flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid #cfc6b0; position: relative; transition: background 0.25s ease, border-color 0.25s ease; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--navy-700); transform: translate(-50%, -50%); transition: transform 0.3s var(--ease), background 0.25s ease; }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .plus { background: var(--navy-700); border-color: var(--navy-700); }
  details[open] .plus::before, details[open] .plus::after { background: #fff; }
  details[open] .plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  details p { padding: 0 52px 20px 0; color: var(--slate); max-width: 62ch; }

  @media (max-width: 900px) {
    .proc-side, .faq-side, .psteps, .faqs { grid-column: 1 / -1; }
    .proc-side, .faq-side { position: static; }
    .proc-now { display: none; }
  }
  @media (max-width: 560px) {
    .psteps li { grid-template-columns: 1fr; gap: 10px; }
    details p { padding-right: 0; }
  }
</style>
