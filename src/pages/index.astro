---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import LiveConsole from '../components/home/LiveConsole.astro';
import WorkGrid from '../components/WorkGrid.astro';

// Each figure is checkable: the test count comes from the ASTA OS repository,
// the other two are the owner's own stated figures for that system and its builder.
const figures = [
  { value: 2808, prefix: '', suffix: '', label: 'automated tests guard our first production system' },
  { value: 15, prefix: '', suffix: '+', label: 'years of running operations before writing software' },
  { value: 9000, prefix: '$', suffix: '+', label: 'in operating cost avoided by ASTA OS' },
  { value: 0, prefix: '', suffix: '', label: 'messages, approvals or payments made without a person' },
];

// Each place the work lives today, paired with what replaces it.
const shifts = [
  { icon: 'table', from: 'Spreadsheets', fromWhat: 'Quotes, costs and trackers', to: 'One place for the work', toWhat: 'Enquiries, quotes, orders, projects and outreach' },
  { icon: 'inbox', from: 'Inboxes', fromWhat: 'Enquiries, approvals and follow-ups', to: 'Prepared for you to decide', toWhat: 'The system drafts. A person approves.' },
  { icon: 'user', from: 'One person’s memory', fromWhat: 'How it all fits together', to: 'Built around how you work', toWhat: 'Your process, not a template' },
];

const systemDoes = [
  'Reads the enquiry, the PDF, the lab reading',
  'Matches vendors, buyers and projects',
  'Computes cost, duty and margin',
  'Drafts the quotation and the first email',
  'Flags what is unusual',
  'Keeps the log of who did what, and when',
];
const personOnly = ['Approves a price', 'Sends a message', 'Releases a batch', 'Confirms a receipt or payment', 'Overrides a credit limit', 'Changes a rule'];

const shipFacts = [
  { n: '2,808', l: 'automated tests' },
  { n: '54', l: 'database migrations' },
  { n: '2-factor', l: 'sign-in on every account' },
];

const steps = [
  { title: 'Discover', text: 'We map how work moves through your business today, and where it waits or leaks.' },
  { title: 'Mock-up', text: 'You click through your system with sample data before committing to a build.' },
  { title: 'Build', text: 'One complete job, end to end, then the next. Tests and access rules from day one.' },
  { title: 'Launch', text: 'Rehearsed on a test copy with your real master data before the switch.' },
  { title: 'Improve', text: 'The system keeps changing as your business does.' },
];
---
<Base
  title="MetricAscent | Custom AI systems your business runs on"
  description="MetricAscent builds custom AI operations systems for owner-led businesses: enquiries, quotes, orders, projects and outreach in one system built around how you already work."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="live-pill" href="/work/asta-os/">
          <span class="dot" aria-hidden="true"></span>
          <span>ASTA OS is live in production</span>
          <Icon name="arrow-right" />
        </a>
        <h1>
          <span class="line"><span>We build the</span></span>
          <span class="line"><span>AI system your</span></span>
          <span class="line"><span>business <em>runs on.</em></span></span>
        </h1>
        <p class="lede">Custom operations software for owner-led companies, built around how you already work.</p>
        <div class="actions">
          <a class="btn btn-gold" href="/contact/">See your system mocked up <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="#work">View our work</a>
        </div>
      </div>
      <div class="console-stage">
        <div class="console-wrap">
          <LiveConsole />
        </div>
      </div>
    </div>

    <div class="wrap">
      <ul class="stats figures" data-figures data-reveal>
        {figures.map((f) => (
          <li>
            <strong data-count={f.value} data-prefix={f.prefix} data-suffix={f.suffix}>{f.prefix}{f.value.toLocaleString('en-US')}{f.suffix}</strong>
            <span>{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2>We replace spreadsheets, inboxes and memory with one system.</h2>
        <p>Off-the-shelf software asks you to change how you work. We build the system around the work you already do.</p>
      </div>

      <div class="shift" data-reveal>
        <div class="shift-head" aria-hidden="true">
          <p>Where the work lives today</p>
          <p>With your system</p>
        </div>
        <ul>
          {shifts.map((r) => (
            <li>
              <div class="cell from">
                <span class="s-icon"><Icon name={r.icon} /></span>
                <div><p class="s-label">Today</p><p class="s-name">{r.from}</p><p class="s-what">{r.fromWhat}</p></div>
              </div>
              <span class="s-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
              <div class="cell to">
                <span class="s-icon"><Icon name="check" /></span>
                <div><p class="s-label">With your system</p><p class="s-name">{r.to}</p><p class="s-what">{r.toWhat}</p></div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sec-soft" id="work">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div class="section-head">
          <p class="eyebrow">Our work</p>
          <h2>Four systems, each built for one business.</h2>
          <p>One is in production, one is about to launch, two are earlier. We say which is which, and every screen shows sample data.</p>
        </div>
        <a class="text-link" href="/work/">All work <Icon name="arrow-right" /></a>
      </div>
      <WorkGrid />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div class="section-head">
          <p class="eyebrow">How our systems behave</p>
          <h2>Software prepares. A person decides.</h2>
          <p>Owners are right to worry about AI acting on its own. Ours does not. It does the reading, matching and drafting, then stops and waits for you.</p>
        </div>
        <a class="text-link" href="/approach/">Our approach <Icon name="arrow-right" /></a>
      </div>

      <div class="split" data-reveal>
        <div class="split-side">
          <p class="split-h"><span class="split-ic"><Icon name="workflow" /></span>The system does</p>
          <ul>
            {systemDoes.map((t) => <li><Icon name="check" /><span>{t}</span></li>)}
          </ul>
        </div>
        <div class="split-gate" aria-hidden="true"><span>Stops here</span></div>
        <div class="split-side you">
          <p class="split-h"><span class="split-ic"><Icon name="user-check" /></span>Only a person can</p>
          <ul>
            {personOnly.map((t) => <li><Icon name="user-check" /><span>{t}</span></li>)}
          </ul>
        </div>
      </div>

      <div class="tested" data-reveal>
        <div>
          <h3>Nothing goes live until every check passes.</h3>
          <p>ASTA OS cannot be released unless all of its automated checks pass. We build every system to that standard.</p>
        </div>
        <ul>
          {shipFacts.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sec-soft process">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2>You see it before you commit to it.</h2>
        <p>Every project starts with a clickable version of your system, using sample data.</p>
      </div>
      <ol class="steps" data-reveal>
        {steps.map((s, i) => (
          <li>
            <h3><span class="node">{i + 1}</span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));

  // Figures count up once when they come into view.
  const figures = document.querySelector<HTMLElement>('[data-figures]');
  if (figures && motionOK && 'IntersectionObserver' in window) {
    const nums = Array.from(figures.querySelectorAll<HTMLElement>('[data-count]'));
    const fmt = (el: HTMLElement, v: number) => `${el.dataset.prefix ?? ''}${Math.round(v).toLocaleString('en-US')}${el.dataset.suffix ?? ''}`;
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      nums.forEach((el, i) => {
        const target = Number(el.dataset.count);
        if (!target) return;
        const start = performance.now() + i * 120;
        const dur = 1500;
        el.textContent = fmt(el, 0);
        const tick = (now: number) => {
          const p = clamp((now - start) / dur);
          el.textContent = fmt(el, target * (1 - Math.pow(1 - p, 4)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    io.observe(figures);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  /* A deep navy hero: the console sits on it as a slightly lighter, outlined panel. */
  .hero { position: relative; isolation: isolate; overflow: clip; background: linear-gradient(170deg, #0a1728 0%, #0e2238 55%, #102a45 100%); color: #b7c6d6; padding-top: clamp(104px, 15vh, 172px); padding-bottom: clamp(40px, 5vw, 64px); }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(720px 460px at 82% 18%, rgba(124, 196, 255, 0.12), transparent 62%), radial-gradient(640px 420px at 4% 100%, rgba(201, 162, 63, 0.12), transparent 62%); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 70% at 72% 30%, #000 0%, transparent 72%); }
  .console-stage { position: relative; min-width: 0; }
  .console-stage::before { content: ''; position: absolute; inset: -12% -10%; z-index: -1; pointer-events: none; border-radius: 50%; background: radial-gradient(closest-side, rgba(225, 189, 99, 0.2), rgba(124, 196, 255, 0.1) 55%, transparent 78%); filter: blur(24px); }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 600px); gap: clamp(32px, 4.5vw, 72px); align-items: center; }
  .hero-copy { min-width: 0; }
  .live-pill { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; padding: 4px 11px 4px 9px; border-radius: 999px; text-decoration: none; font-size: 12px; line-height: 1.35; color: #e6edf5; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.14); transition: border-color 0.25s ease; }
  .live-pill { position: relative; }
  .live-pill::before { content: ''; position: absolute; inset: -9px -4px; }
  .live-pill:hover { border-color: rgba(255, 255, 255, 0.36); }
  .live-pill :global(svg) { width: 12px; height: 12px; flex: none; color: var(--gold-light); transition: transform 0.25s ease; }
  .live-pill:hover :global(svg) { transform: translateX(3px); }
  .dot { position: relative; width: 6px; height: 6px; flex: none; border-radius: 50%; background: #3ecf82; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: #3ecf82; }
  .hero h1 em { color: var(--gold-light); }
  .hero h1 { color: #fff; margin-top: 22px; font-size: clamp(2.5rem, min(4.7vw, 10vh), 4.2rem); line-height: 1.02; }
  .line { display: block; overflow: hidden; padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .line > span { display: block; white-space: nowrap; }
  .hero .lede { max-width: 40ch; margin-top: 22px; text-wrap: balance; font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: #b7c6d6; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .console-wrap { position: relative; min-width: 0; border-radius: 22px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 40px 90px -40px rgba(0, 0, 0, 0.8); }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after { animation: ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite; }
    .live-pill { animation: fade-up 0.8s var(--ease) both; }
    .line > span { animation: line-up 1.05s var(--ease) both; }
    .line:nth-child(2) > span { animation-delay: 0.1s; }
    .line:nth-child(3) > span { animation-delay: 0.2s; }
    .hero .lede { animation: fade-up 0.9s var(--ease) 0.3s both; }
    .actions { animation: fade-up 0.9s var(--ease) 0.42s both; }
    .console-wrap { animation: console-in 1.3s var(--ease) 0.35s both; }
    @keyframes ping { 0% { transform: scale(1); opacity: 0.7; } 80%, 100% { transform: scale(3.2); opacity: 0; } }
    @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }
    @keyframes line-up { from { transform: translateY(108%); } }
    @keyframes console-in { from { opacity: 0; transform: translateY(46px) scale(0.975); } }
  }

  /* On desktop the headline and console fill exactly the first screen, centred between the header
     and the bottom edge. The figures start just below it, so nothing is cut off at the fold. */
  @media (min-width: 1000px) {
    .hero { padding-top: 72px; }
    .hero-grid { min-height: calc(100svh - 72px); padding-block: 24px; }
    .figures { margin-top: 0; }
  }

  /* ---------- Fit the first screen ----------
     On short desktop screens the console scales down in steps and the copy tightens,
     so the headline, both buttons and the whole console are visible without scrolling. */
  @media (min-width: 1000px) and (max-height: 759px) {
    .hero h1 { margin-top: 18px; font-size: clamp(2.3rem, min(4.7vw, 9.6vh), 4.2rem); }
    .hero .lede { margin-top: 16px; font-size: 1.05rem; }
    .actions { margin-top: 22px; }
  }
  @media (min-width: 1000px) and (max-height: 629px) {
    .hero h1 { margin-top: 12px; }
    .hero .lede { margin-top: 12px; }
    .actions { margin-top: 16px; }
  }
  /* tall screens have room for a slightly larger console */
  @media (min-width: 1200px) and (min-height: 880px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 648px); } .console-wrap { zoom: 1.08; } }
  /* large monitors: the whole hero scales up so it still fills the screen */
  @media (min-width: 1600px) and (min-height: 1000px) {
    .hero .wrap { max-width: 1480px; }
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 750px); }
    .console-wrap { zoom: 1.25; }
    .hero h1 { font-size: 4.5rem; }
    .hero .lede { font-size: 1.5rem; }
    .actions .btn { min-height: 56px; padding-inline: 28px; font-size: 17px; }
  }
  @media (min-width: 2200px) and (min-height: 1300px) {
    .hero .wrap { max-width: 1860px; }
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 960px); }
    .console-wrap { zoom: 1.6; }
    .hero h1 { font-size: 5.8rem; }
    .hero .lede { font-size: 1.9rem; }
    .live-pill { zoom: 1.4; }
    .actions .btn { min-height: 66px; padding-inline: 34px; font-size: 20px; }
  }
  @media (min-width: 1000px) and (max-height: 759px) { .console-wrap { zoom: 0.99; } }
  @media (min-width: 1000px) and (max-height: 719px) { .console-wrap { zoom: 0.94; } }
  @media (min-width: 1000px) and (max-height: 689px) { .console-wrap { zoom: 0.89; } }
  @media (min-width: 1000px) and (max-height: 659px) { .console-wrap { zoom: 0.84; } }
  @media (min-width: 1000px) and (max-height: 629px) { .console-wrap { zoom: 0.79; } }
  @media (min-width: 1000px) and (max-height: 599px) { .console-wrap { zoom: 0.74; } }
  @media (min-width: 1000px) and (max-height: 569px) { .console-wrap { zoom: 0.69; } }
  @media (min-width: 1000px) and (max-height: 539px) { .console-wrap { zoom: 0.64; } }

  /* Small laptops and landscape tablets: the two columns share the width evenly and the
     headline scales with it, so its one-line rows never run under the console. */
  @media (min-width: 1000px) and (max-width: 1180px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 46%); gap: 32px; }
    .hero h1 { font-size: clamp(2.2rem, min(4.5vw, 9.6vh), 3.3rem); }
    .hero .lede { font-size: 1rem; }
  }
  @media (min-width: 1000px) and (max-width: 1180px) and (min-height: 760px) and (max-height: 880px) { .console-wrap { zoom: 0.91; } }

  .figures { margin-top: clamp(40px, 5vw, 64px); }
  .figures li { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); box-shadow: none; }
  .figures strong { color: #fff; }
  .figures span { color: #a9bacc; }
  .figures li:last-child strong { color: var(--gold-light); }

  /* ---------- Section heads with a link on the right ---------- */
  .head-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; margin-bottom: clamp(32px, 4vw, 48px); }
  .head-row .section-head { margin-bottom: 0; }

  /* ---------- What we do: one card split down the middle, each row a before and its after ---------- */
  .shift { border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow-sm); background: linear-gradient(90deg, var(--bg-soft) 0 50%, var(--navy-800) 50% 100%); }
  .shift-head, .shift li { display: grid; grid-template-columns: 1fr 1fr; }
  .shift-head p { padding: 14px clamp(18px, 2.4vw, 30px) 0; font-family: var(--font-head); font-size: 11.5px; font-weight: 680; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-light); }
  .shift-head p + p { color: var(--gold-light); padding-left: clamp(30px, 3.4vw, 46px); }
  .shift li { position: relative; align-items: center; }
  .shift li + li .cell.from { border-top: 1px solid var(--line); }
  .shift li + li .cell.to { border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .cell { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 14px; align-items: center; height: 100%; padding: 14px clamp(18px, 2.4vw, 30px); }
  .cell.to { padding-left: clamp(30px, 3.4vw, 46px); }
  .s-label { display: none; }
  .s-icon { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: #fff; border: 1px solid var(--line); color: var(--slate); }
  .s-icon :global(svg) { width: 18px; height: 18px; }
  .to .s-icon { background: rgba(225, 189, 99, 0.16); border-color: transparent; color: var(--gold-light); }
  .to .s-icon :global(svg) { stroke-width: 2.6; }
  .s-name { font-family: var(--font-head); font-weight: 620; font-size: 15.5px; line-height: 1.3; color: var(--navy-700); }
  .s-what { font-size: 14px; line-height: 1.4; color: var(--slate-light); }
  .from .s-name { color: var(--slate); text-decoration: line-through; text-decoration-color: rgba(83, 96, 116, 0.45); }
  .to .s-name { color: #fff; }
  .to .s-what { color: #a9bacc; }
  /* the arrow sits on the seam between the two halves */
  .s-arrow { position: absolute; left: 50%; top: 50%; z-index: 1; width: 32px; height: 32px; margin: -16px 0 0 -16px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: var(--navy-900); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.9), 0 8px 18px -8px rgba(8, 20, 36, 0.6); }
  .s-arrow :global(svg) { width: 16px; height: 16px; }

  /* one card, two halves: what the system does (white, blue tags), the point where it stops,
     and what only a person can do (navy, gold tags). Tags flow, so no line breaks awkwardly. */
  .split { display: grid; grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr); border-radius: 20px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); overflow: hidden; }
  .split-side { padding: clamp(20px, 2.2vw, 28px) clamp(20px, 2.6vw, 32px); }
  .split-side.you { padding-left: clamp(30px, 3.2vw, 44px); background: linear-gradient(160deg, var(--navy-800), var(--navy-900)); }
  .split-h { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 480; font-size: clamp(1.25rem, 1.7vw, 1.45rem); letter-spacing: -0.02em; line-height: 1.2; color: var(--navy-700); }
  .you .split-h { color: #fff; }
  .split-ic { width: 34px; height: 34px; flex: none; border-radius: 10px; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); }
  .you .split-ic { background: rgba(225, 189, 99, 0.16); color: var(--gold-light); }
  .split-ic :global(svg) { width: 17px; height: 17px; }
  .split-side ul { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .split-side li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px 7px 10px; border-radius: 999px; font-size: 14px; line-height: 1.3; color: var(--navy-700); background: #f1f5fb; border: 1px solid #dfe8f4; }
  .split-side li :global(svg) { width: 15px; height: 15px; flex: none; color: var(--blue); stroke-width: 2.6; }
  .you li { color: #fff; background: rgba(255, 255, 255, 0.06); border-color: rgba(225, 189, 99, 0.35); }
  .you li :global(svg) { color: var(--gold-light); stroke-width: 2; }
  .split-gate { position: relative; width: 0; }
  .split-gate span { position: absolute; z-index: 1; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-90deg); white-space: nowrap; padding: 5px 12px; border-radius: 999px; background: var(--gold); color: var(--navy-900); box-shadow: 0 0 0 4px #fff; font-family: var(--font-head); font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }

  /* the release standard: a navy strip under the card */
  .tested { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 40px; align-items: center; margin-top: clamp(14px, 1.6vw, 20px); padding: clamp(16px, 1.8vw, 22px) clamp(18px, 2.2vw, 28px); border-radius: 20px; color: #b7c6d6; background: linear-gradient(160deg, var(--navy-800), var(--navy-900)); box-shadow: 0 24px 44px -30px rgba(8, 20, 36, 0.6); }
  .tested h3 { font-size: 1rem; line-height: 1.3; color: #fff; }
  .tested p { margin-top: 3px; font-size: 14px; line-height: 1.5; max-width: 60ch; }
  .tested ul { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .tested li { display: flex; align-items: baseline; gap: 8px; }
