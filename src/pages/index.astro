---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import SystemVisual from '../components/SystemVisual.astro';
import CtaBand from '../components/CtaBand.astro';
import { systems, statusLabel, getSystem } from '../data/systems';

const plant = getSystem('plant-os');
const asta = getSystem('asta-os');
const heroMain = plant.screens[0];
const heroPhone = plant.screens[2];
const heroBack = asta.screens[0];

const proof = [
  { n: 'Oct 2026', l: 'first system went live' },
  { n: '2,800+', l: 'automated tests' },
  { n: 'Two-factor', l: 'sign-in on every account' },
  { n: '$9,000+', l: 'in operating cost avoided' },
];

const build = [
  { icon: 'workflow', title: 'Operations systems', text: 'Enquiry to quotation to purchase order to profit, in one place instead of five.', slug: 'asta-os' },
  { icon: 'smartphone', title: 'Client apps and staff portals', text: 'Customers see their project. Your team runs it. Everyone sees only what they should.', slug: 'aasta-lifespace' },
  { icon: 'target', title: 'Lead engines', text: 'Find the right buyers, prove the fit, and have the first message drafted for you.', slug: 'lead-engine' },
  { icon: 'factory', title: 'Plant and factory systems', text: 'Production, quality checks, dispatch and compliance on a single screen.', slug: 'plant-os' },
];

const principles = [
  { icon: 'user-check', title: 'A person decides', text: 'Nothing is sent, approved or paid without a human. The system prepares the work; your people make the call.' },
  { icon: 'database', title: 'Rules live in the database', text: 'Business rules are enforced where no screen or shortcut can route around them.' },
  { icon: 'lock', title: 'Locked by role', text: 'Each person sees what their job needs. Sensitive actions are logged with who, what and when.' },
  { icon: 'code', title: 'You own it', text: 'The code and the data are yours. The system is built for your business alone.' },
];

const steps = [
  { title: 'Discover', text: 'We map how work moves through your business today, and where it waits or leaks.' },
  { title: 'Mock-up', text: 'You click through your system with sample data before committing to a build.' },
  { title: 'Build', text: 'One complete job, end to end, then the next. Tests and access rules from day one.' },
  { title: 'Launch', text: 'Rehearsed on a test copy with your real master data before the switch.' },
  { title: 'Improve', text: 'The system keeps changing as your business does.' },
];
---
<Base
  title="MetricAscent | Custom AI systems your business runs on"
  description="MetricAscent builds custom AI operations systems for owner-led businesses: enquiries, quotes, orders, projects and outreach in one system built around how you already work."
>
  <section class="hero on-navy">
    <div class="wrap hero-copy">
      <p class="eyebrow">Custom AI operations systems</p>
      <h1>We build the AI system your business <span>runs on.</span></h1>
      <p class="lede">Custom operations software for owner-led companies. Enquiries, quotes, orders, projects and outreach in one system, built around how you already work.</p>
      <div class="actions">
        <a class="btn btn-gold" href="/contact/">See your system mocked up <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost" href="/work/">View our work</a>
      </div>
      <p class="note">Built by an operator with 15+ years running real businesses.</p>
    </div>
    <div class="wrap">
      <div class="stage">
        <div class="back"><Shot screen={heroBack} sizes="480px" /></div>
        <div class="main"><Shot screen={heroMain} eager sizes="(max-width: 720px) 92vw, 820px" /></div>
        <div class="handset"><Shot screen={heroPhone} eager sizes="(max-width: 720px) 26vw, 170px" /></div>
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="wrap">
      <ul class="proof-grid">
        {proof.map((p) => (
          <li><strong>{p.n}</strong><span>{p.l}</span></li>
        ))}
      </ul>
      <p class="note proof-note">Figures from ASTA OS, our first system in production. Screens above are real builds showing sample data.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap problem">
      <div data-reveal>
        <p class="eyebrow">The problem</p>
        <h2>Off-the-shelf software fits someone else’s business.</h2>
      </div>
      <div class="problem-body" data-reveal>
        <p class="lede">Your process lives in spreadsheets, inboxes and one person’s memory. Generic tools make you change how you work.</p>
        <p class="lede strong">We build the system around the work.</p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What we build</p>
        <h2>Four kinds of system. Each one backed by a real build.</h2>
      </div>
      <div class="build-grid">
        {build.map((b) => (
          <a class="card build-card" href={`/work/${b.slug}/`} data-reveal>
            <span class="icon-tile"><Icon name={b.icon} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
            <span class="see">See {getSystem(b.slug).name} <Icon name="arrow-right" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Our work</p>
        <h2>Systems we have built, and exactly where each one stands.</h2>
        <p>One is in production, one is about to launch, two are earlier. We label them honestly, and every screen shows sample data.</p>
      </div>
      <div class="work-list">
        {systems.map((s, i) => (
          <article class:list={['work-row', { flip: i % 2 === 1 }]} data-reveal>
            <div class="work-copy">
              <p class="work-meta"><span class={`status status-${s.status}`}>{statusLabel[s.status]}</span><span class="kind">{s.kind}</span></p>
              <h3>{s.name}</h3>
              <p class="tagline">{s.tagline}</p>
              <ul class="checks">
                {s.highlights.map((h) => <li><Icon name="check" /><span>{h}</span></li>)}
              </ul>
              <a class="text-link" href={`/work/${s.slug}/`}>Read the case study <Icon name="arrow-right" /></a>
            </div>
            <div class="work-visual"><SystemVisual system={s} /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="wrap principles">
      <div class="principles-head" data-reveal>
        <p class="eyebrow">How our systems behave</p>
        <h2>Software prepares.<br /><span>A person decides.</span></h2>
        <p>Owners are right to worry about AI acting on its own. Ours does not. It reads, drafts, checks and flags, then waits for you.</p>
        <a class="text-link" href="/approach/">Our approach <Icon name="arrow-right" /></a>
      </div>
      <ul class="principle-grid">
        {principles.map((p) => (
          <li data-reveal>
            <span class="p-icon"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2>You see it before you commit to it.</h2>
        <p>Every project starts with a clickable version of your system, using sample data.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-reveal>
            <span class="step-n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { position: relative; display: flow-root; background: radial-gradient(1100px 520px at 50% -8%, #1d4369 0%, transparent 62%), linear-gradient(180deg, var(--navy-950) 0%, var(--navy-800) 72%); color: #c8d5e3; padding-top: clamp(56px, 8vw, 104px); }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);
  }
  .hero .wrap { position: relative; }
  .hero-copy { text-align: center; }
  .hero h1 { color: #fff; max-width: 17ch; margin: 20px auto 0; }
  .hero h1 span { color: var(--gold-light); }
  .hero .lede { color: #b9c8d8; max-width: 60ch; margin: 24px auto 0; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 34px; }
  .hero .note { margin-top: 22px; }

  .stage { position: relative; max-width: 1080px; margin: clamp(44px, 6vw, 72px) auto -120px; z-index: 2; }
  .stage .main { position: relative; z-index: 2; width: 76%; margin-left: 15%; }
  .stage .back { position: absolute; z-index: 1; left: 0; top: 17%; width: 46%; opacity: 0.96; }
  .stage .handset { position: absolute; z-index: 3; right: 1%; bottom: -5%; width: 15.5%; }
  @media (prefers-reduced-motion: no-preference) {
    .stage .handset { animation: float 7s ease-in-out infinite; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  }

  /* Proof strip */
  .proof { padding-top: 172px; padding-bottom: clamp(36px, 5vw, 56px); border-bottom: 1px solid var(--line); }
  .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .proof-grid li { padding: 6px 28px; border-left: 1px solid var(--line); display: grid; gap: 4px; }
  .proof-grid li:first-child { border-left: 0; padding-left: 0; }
  .proof-grid strong { font-family: var(--font-head); font-size: clamp(1.5rem, 2.8vw, 2.1rem); font-weight: 720; letter-spacing: -0.03em; color: var(--navy-700); line-height: 1.15; }
  .proof-grid span { color: var(--slate); font-size: 15px; }
  .proof-note { margin-top: 26px; }

  /* Problem */
  .problem { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 6vw, 88px); align-items: end; }
  .problem h2 { margin-top: 16px; }
  .problem-body { display: grid; gap: 16px; }
  .lede.strong { color: var(--navy-700); font-family: var(--font-head); font-weight: 650; }

  /* What we build */
  .build-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .build-card { display: grid; gap: 14px; align-content: start; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .build-card:hover { transform: translateY(-5px); border-color: var(--gold); box-shadow: 0 18px 40px -18px rgba(12, 30, 51, 0.3); }
  .build-card p { color: var(--slate); font-size: 15.5px; }
  .see { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-family: var(--font-head); font-weight: 620; font-size: 14.5px; color: var(--navy-700); }
  .see :global(svg) { width: 15px; height: 15px; color: var(--gold); transition: transform 0.18s ease; }
  .build-card:hover .see :global(svg) { transform: translateX(4px); }

  /* Work rows */
  .work-list { display: grid; gap: clamp(64px, 9vw, 120px); }
  .work-row { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .work-row.flip .work-copy { order: 2; }
  .work-row.flip { grid-template-columns: 1.18fr 0.82fr; }
  .work-copy { display: grid; gap: 18px; justify-items: start; }
  .work-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .kind { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-light); }
  .work-copy h3 { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 720; letter-spacing: -0.03em; }
  .tagline { color: var(--slate); font-size: 1.1rem; }
  .work-copy .checks { margin-block: 4px 6px; }

  /* Principles */
  .principles { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .principles-head { display: grid; gap: 20px; justify-items: start; position: sticky; top: 112px; }
  .principles-head h2 { font-size: clamp(2rem, 4.2vw, 3.1rem); }
  .principles-head h2 span { color: var(--gold-light); }
  .principles-head p:not(.eyebrow) { color: #b7c6d6; font-size: 1.1rem; }
  .principle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .principle-grid li { background: rgba(255, 255, 255, 0.045); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius); padding: 26px; display: grid; gap: 12px; align-content: start; }
  .p-icon { width: 44px; height: 44px; border-radius: 11px; background: rgba(225, 189, 99, 0.14); color: var(--gold-light); display: grid; place-items: center; }
  .p-icon :global(svg) { width: 21px; height: 21px; }
  .principle-grid p { color: #b7c6d6; font-size: 15.5px; }

  /* Steps */
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; counter-reset: step; position: relative; }
  .steps::before { content: ''; position: absolute; left: 4%; right: 4%; top: 22px; height: 2px; background: repeating-linear-gradient(90deg, #cfd7e1 0 8px, transparent 8px 16px); }
  .steps li { position: relative; display: grid; gap: 10px; align-content: start; }
  .step-n { width: 46px; height: 46px; border-radius: 50%; background: var(--navy-700); color: var(--gold-light); display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; font-size: 17px; box-shadow: 0 0 0 7px var(--bg-soft); }
  .steps h3 { margin-top: 8px; }
  .steps p { color: var(--slate); font-size: 15.5px; }

  @media (max-width: 1020px) {
    .build-grid { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr 1fr 1fr; row-gap: 36px; }
    .steps::before { display: none; }
  }
  @media (max-width: 860px) {
    .problem, .principles, .work-row, .work-row.flip { grid-template-columns: 1fr; }
    .work-row.flip .work-copy { order: 0; }
    .principles-head { position: static; }
    .proof-grid { grid-template-columns: 1fr 1fr; row-gap: 26px; }
    .proof-grid li:nth-child(odd) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 720px) {
    .stage { margin-bottom: -64px; }
    .stage .back { display: none; }
    .stage .main { width: 100%; margin-left: 0; }
    .stage .handset { width: 25%; right: -1%; bottom: -9%; }
    .proof { padding-top: 112px; }
    .actions .btn { width: 100%; }
  }
  @media (max-width: 560px) {
    .build-grid, .principle-grid, .steps { grid-template-columns: 1fr; }
    .steps li { grid-template-columns: 46px 1fr; column-gap: 16px; }
    .steps li h3 { margin-top: 0; align-self: center; }
    .steps li p { grid-column: 2; }
  }
</style>
