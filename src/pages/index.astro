---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import LiveConsole from '../components/home/LiveConsole.astro';
import WorkGrid from '../components/WorkGrid.astro';

// Each figure is checkable: the test count comes from the ASTA OS repository,
// the other two are the owner's own stated figures for that system and its builder.
const figures = [
  { value: 2808, prefix: '', suffix: '', label: 'automated tests guard our first production system' },
  { value: 15, prefix: '', suffix: '+', label: 'years of running operations before writing software' },
  { value: 9000, prefix: '$', suffix: '+', label: 'in operating cost avoided by ASTA OS' },
  { value: 0, prefix: '', suffix: '', label: 'messages, approvals or payments made without a person' },
];

// Where a process usually lives before a system exists, and what replaces it.
const before = [
  { icon: 'table', name: 'Spreadsheets', what: 'Quotes, costs and trackers' },
  { icon: 'inbox', name: 'Inboxes', what: 'Enquiries, approvals and follow-ups' },
  { icon: 'user', name: 'One person’s memory', what: 'How it all fits together' },
];
const after = [
  { name: 'One place for the work', what: 'Enquiries, quotes, orders, projects and outreach' },
  { name: 'Built around how you work', what: 'Your process, not a template' },
  { name: 'Prepared for you to decide', what: 'The system drafts. A person approves.' },
];

const systemDoes = [
  'Reads the enquiry, the PDF, the lab reading',
  'Matches vendors, buyers and projects',
  'Computes cost, duty and margin',
  'Drafts the quotation and the first email',
  'Flags what is unusual',
  'Keeps the log of who did what, and when',
];
const personOnly = ['Approves a price', 'Sends a message', 'Releases a batch', 'Confirms a receipt or payment', 'Overrides a credit limit', 'Changes a rule'];

const guards = [
  { icon: 'database', title: 'Rules cannot be bypassed', text: 'Business rules are enforced in the database, where no screen or shortcut can route around them.' },
  { icon: 'lock', title: 'Locked by role', text: 'Each person sees what their job needs, and nothing more.' },
  { icon: 'eye', title: 'Every action leaves a record', text: 'Sensitive actions are logged with who, what and when. The log cannot be edited.' },
];

const shipFacts = [
  { n: '2,808', l: 'automated tests' },
  { n: '54', l: 'database migrations' },
  { n: '2-factor', l: 'sign-in on every account' },
];

const steps = [
  { title: 'Discover', text: 'We map how work moves through your business today, and where it waits or leaks.' },
  { title: 'Mock-up', text: 'You click through your system with sample data before committing to a build.' },
  { title: 'Build', text: 'One complete job, end to end, then the next. Tests and access rules from day one.' },
  { title: 'Launch', text: 'Rehearsed on a test copy with your real master data before the switch.' },
  { title: 'Improve', text: 'The system keeps changing as your business does.' },
];
---
<Base
  title="MetricAscent | Custom AI systems your business runs on"
  description="MetricAscent builds custom AI operations systems for owner-led businesses: enquiries, quotes, orders, projects and outreach in one system built around how you already work."
  darkTop
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="live-pill" href="/work/asta-os/">
          <span class="dot" aria-hidden="true"></span>
          <span>ASTA OS is live in production</span>
          <Icon name="arrow-right" />
        </a>
        <h1>
          <span class="line"><span>We build the</span></span>
          <span class="line"><span>AI system your</span></span>
          <span class="line"><span>business <em>runs on.</em></span></span>
        </h1>
        <p class="lede">Custom operations software for owner-led companies. Enquiries, quotes, orders, projects and outreach in one system, built around how you already work.</p>
        <div class="actions">
          <a class="btn btn-gold" href="/contact/">See your system mocked up <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="#work">View our work</a>
        </div>
        <p class="by">Built by an operator with 15+ years running real businesses.</p>
      </div>
      <div class="console-wrap">
        <LiveConsole />
      </div>
    </div>

    <div class="wrap">
      <ul class="stats figures" data-figures>
        {figures.map((f) => (
          <li>
            <strong data-count={f.value} data-prefix={f.prefix} data-suffix={f.suffix}>{f.prefix}{f.value.toLocaleString('en-US')}{f.suffix}</strong>
            <span>{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2>We replace spreadsheets, inboxes and memory with one system.</h2>
        <p>Off-the-shelf software asks you to change how you work. We build the system around the work you already do.</p>
      </div>

      <div class="shift" data-reveal>
        <div class="shift-card">
          <p class="label">Where the work lives today</p>
          <ul>
            {before.map((b) => (
              <li>
                <span class="s-icon"><Icon name={b.icon} /></span>
                <span class="s-name">{b.name}</span>
                <span class="s-what">{b.what}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="shift-arrow" aria-hidden="true"><Icon name="arrow-right" /></div>
        <div class="shift-card after">
          <p class="label">With your system</p>
          <ul>
            {after.map((a) => (
              <li>
                <span class="s-icon"><Icon name="check" /></span>
                <span class="s-name">{a.name}</span>
                <span class="s-what">{a.what}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-soft" id="work">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div class="section-head">
          <p class="eyebrow">Our work</p>
          <h2>Four systems, each built for one business.</h2>
          <p>One is in production, one is about to launch, two are earlier. We say which is which, and every screen shows sample data.</p>
        </div>
        <a class="text-link" href="/work/">All work <Icon name="arrow-right" /></a>
      </div>
      <WorkGrid />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div class="section-head">
          <p class="eyebrow">How our systems behave</p>
          <h2>Software prepares. A person decides.</h2>
          <p>Owners are right to worry about AI acting on its own. Ours does not. It does the reading, matching and drafting, then stops and waits for you.</p>
        </div>
        <a class="text-link" href="/approach/">Our approach <Icon name="arrow-right" /></a>
      </div>

      <div class="split" data-reveal>
        <div class="split-card">
          <p class="split-h"><span class="split-ic"><Icon name="workflow" /></span>The system does</p>
          <ul>
            {systemDoes.map((t) => <li><Icon name="check" /><span>{t}</span></li>)}
          </ul>
        </div>
        <div class="split-card you">
          <p class="split-h"><span class="split-ic"><Icon name="user-check" /></span>Only a person can</p>
          <ul>
            {personOnly.map((t) => <li><Icon name="user-check" /><span>{t}</span></li>)}
          </ul>
        </div>
      </div>

      <ul class="guards">
        {guards.map((g) => (
          <li data-reveal>
            <span class="g-icon"><Icon name={g.icon} /></span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </li>
        ))}
      </ul>

      <div class="tested" data-reveal>
        <div>
          <h3>Nothing goes live until every check passes.</h3>
          <p>ASTA OS cannot be released unless all of its automated checks pass. We build every system to that standard.</p>
        </div>
        <ul>
          {shipFacts.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sec-soft">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2>You see it before you commit to it.</h2>
        <p>Every project starts with a clickable version of your system, using sample data.</p>
      </div>
      <ol class="steps" data-steps>
        {steps.map((s, i) => (
          <li>
            <span class="node"><b>{String(i + 1).padStart(2, '0')}</b></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));

  // Figures count up once when they come into view.
  const figures = document.querySelector<HTMLElement>('[data-figures]');
  if (figures && motionOK && 'IntersectionObserver' in window) {
    const nums = Array.from(figures.querySelectorAll<HTMLElement>('[data-count]'));
    const fmt = (el: HTMLElement, v: number) => `${el.dataset.prefix ?? ''}${Math.round(v).toLocaleString('en-US')}${el.dataset.suffix ?? ''}`;
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      nums.forEach((el, i) => {
        const target = Number(el.dataset.count);
        if (!target) return;
        const start = performance.now() + i * 120;
        const dur = 1500;
        el.textContent = fmt(el, 0);
        const tick = (now: number) => {
          const p = clamp((now - start) / dur);
          el.textContent = fmt(el, target * (1 - Math.pow(1 - p, 4)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    io.observe(figures);
  }

  // Scroll-linked: the process line draws itself.
  const stepsEl = document.querySelector<HTMLElement>('[data-steps]');
  const stepItems = stepsEl ? Array.from(stepsEl.children) as HTMLElement[] : [];
  if (motionOK) {
    stepsEl?.classList.add('armed');
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      if (stepsEl) {
        const r = stepsEl.getBoundingClientRect();
        const p = clamp((vh * 0.78 - r.top) / (vh * 0.42));
        stepsEl.style.setProperty('--p', p.toFixed(3));
        stepItems.forEach((li, i) => li.classList.toggle('on', p >= (i / (stepItems.length - 1)) * 0.96));
      }
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  /* ---------- Hero ---------- */
  /* A deep navy hero: the console sits on it as a slightly lighter, outlined panel. */
  .hero { position: relative; isolation: isolate; overflow: clip; background: linear-gradient(170deg, #0a1728 0%, #0e2238 55%, #102a45 100%); color: #b7c6d6; padding-top: clamp(104px, 15vh, 172px); padding-bottom: clamp(40px, 5vw, 64px); }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(720px 460px at 82% 18%, rgba(124, 196, 255, 0.12), transparent 62%), radial-gradient(640px 420px at 4% 100%, rgba(201, 162, 63, 0.12), transparent 62%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 548px); gap: clamp(32px, 4.5vw, 72px); align-items: center; }
  .hero-copy { min-width: 0; }
  .live-pill { display: inline-flex; align-items: center; gap: 10px; max-width: 100%; padding: 7px 14px 7px 12px; border-radius: 999px; text-decoration: none; font-size: 13.5px; line-height: 1.35; color: #e6edf5; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.14); transition: border-color 0.25s ease; }
  .live-pill:hover { border-color: rgba(255, 255, 255, 0.36); }
  .live-pill :global(svg) { width: 14px; height: 14px; flex: none; color: var(--gold-light); transition: transform 0.25s ease; }
  .live-pill:hover :global(svg) { transform: translateX(3px); }
  .dot { position: relative; width: 8px; height: 8px; flex: none; border-radius: 50%; background: #3ecf82; }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: #3ecf82; }
  .hero h1 em { color: var(--gold-light); }
  .hero h1 { color: #fff; margin-top: 22px; font-size: clamp(2.5rem, min(4.7vw, 10vh), 4.2rem); line-height: 1.02; }
  .line { display: block; overflow: hidden; padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .line > span { display: block; white-space: nowrap; }
  .hero .lede { max-width: 46ch; margin-top: 22px; color: #b7c6d6; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .by { margin-top: 22px; font-size: 14px; color: #8fa2b7; }
  .console-wrap { position: relative; min-width: 0; border-radius: 22px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 40px 90px -40px rgba(0, 0, 0, 0.8); }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after { animation: ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite; }
    .live-pill { animation: fade-up 0.8s var(--ease) both; }
    .line > span { animation: line-up 1.05s var(--ease) both; }
    .line:nth-child(2) > span { animation-delay: 0.1s; }
    .line:nth-child(3) > span { animation-delay: 0.2s; }
    .hero .lede { animation: fade-up 0.9s var(--ease) 0.3s both; }
    .actions { animation: fade-up 0.9s var(--ease) 0.42s both; }
    .by { animation: fade-up 0.9s var(--ease) 0.54s both; }
    .console-wrap { animation: console-in 1.3s var(--ease) 0.35s both; }
    @keyframes ping { 0% { transform: scale(1); opacity: 0.7; } 80%, 100% { transform: scale(3.2); opacity: 0; } }
    @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }
    @keyframes line-up { from { transform: translateY(108%); } }
    @keyframes console-in { from { opacity: 0; transform: translateY(46px) scale(0.975); } }
  }

  /* ---------- Fit the first screen ----------
     On short desktop screens the console scales down in steps and the copy tightens,
     so the headline, both buttons and the whole console are visible without scrolling. */
  @media (min-width: 1000px) and (max-height: 759px) {
    .hero { padding-top: 108px; }
    .hero h1 { margin-top: 18px; font-size: clamp(2.3rem, min(4.7vw, 9.6vh), 4.2rem); }
    .hero .lede { margin-top: 16px; font-size: 1.05rem; }
    .actions { margin-top: 22px; }
    .by { margin-top: 18px; }
  }
  @media (min-width: 1000px) and (max-height: 759px) { .console-wrap { zoom: 0.96; } }
  @media (min-width: 1000px) and (max-height: 719px) { .console-wrap { zoom: 0.91; } }
  @media (min-width: 1000px) and (max-height: 689px) { .console-wrap { zoom: 0.86; } }
  @media (min-width: 1000px) and (max-height: 659px) { .console-wrap { zoom: 0.81; } }
  @media (min-width: 1000px) and (max-height: 629px) { .console-wrap { zoom: 0.76; } }
  @media (min-width: 1000px) and (max-height: 599px) { .console-wrap { zoom: 0.71; } }
  @media (min-width: 1000px) and (max-height: 569px) { .console-wrap { zoom: 0.66; } }
  @media (min-width: 1000px) and (max-height: 539px) { .console-wrap { zoom: 0.61; } }

  /* Small laptops and landscape tablets: the two columns share the width evenly and the
     headline scales with it, so its one-line rows never run under the console. */
  @media (min-width: 1000px) and (max-width: 1180px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 46%); gap: 32px; }
    .hero h1 { font-size: clamp(2.2rem, min(4.5vw, 9.6vh), 3.3rem); }
    .hero .lede { font-size: 1rem; }
  }
  @media (min-width: 1000px) and (max-width: 1180px) and (min-height: 760px) and (max-height: 880px) { .console-wrap { zoom: 0.88; } }

  .figures { margin-top: clamp(40px, 5vw, 64px); }
  .figures li { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); box-shadow: none; }
  .figures strong { color: #fff; }
  .figures span { color: #a9bacc; }
  .figures li:last-child strong { color: var(--gold-light); }

  /* ---------- Section heads with a link on the right ---------- */
  .head-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; margin-bottom: clamp(32px, 4vw, 48px); }
  .head-row .section-head { margin-bottom: 0; }

  /* ---------- What we do: before, after ---------- */
  .shift { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: clamp(14px, 2vw, 28px); align-items: center; }
  .shift-card { height: 100%; padding: clamp(22px, 2.6vw, 32px); border-radius: 20px; background: var(--bg-soft); border: 1px solid var(--line); }
  .shift-card ul { display: grid; gap: 10px; margin-top: 18px; }
  .shift-card li { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; align-items: center; padding: 12px 16px 12px 12px; border-radius: 14px; background: #fff; border: 1px solid var(--line); }
  .s-icon { grid-row: 1 / span 2; width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: #eef2f7; color: var(--slate); }
  .s-icon :global(svg) { width: 19px; height: 19px; }
  .s-name { font-family: var(--font-head); font-weight: 620; font-size: 15.5px; line-height: 1.3; color: var(--navy-700); }
  .s-what { font-size: 14px; line-height: 1.4; color: var(--slate-light); }
  .shift-arrow { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: var(--navy-900); box-shadow: 0 10px 22px -10px rgba(201, 162, 63, 0.8); }
  .shift-arrow :global(svg) { width: 20px; height: 20px; }
  .shift-card.after { background: linear-gradient(160deg, var(--navy-800), var(--navy-900)); border-color: var(--navy-800); box-shadow: 0 30px 56px -34px rgba(8, 20, 36, 0.7); }
  .after .label { color: var(--gold-light); }
  .after li { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.1); }
  .after .s-icon { background: rgba(225, 189, 99, 0.16); color: var(--gold-light); }
  .after .s-icon :global(svg) { stroke-width: 2.6; }
  .after .s-name { color: #fff; }
  .after .s-what { color: #a9bacc; }

  /* ---------- Software prepares, a person decides ---------- */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 24px); }
  .split-card { padding: clamp(22px, 2.6vw, 30px); border-radius: 20px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .split-card.you { background: var(--gold-soft); border-color: #eadfbd; }
  .split-h { display: flex; align-items: center; gap: 12px; font-family: var(--font-head); font-weight: 660; font-size: 1.0625rem; color: var(--navy-700); padding-bottom: 14px; }
  .split-ic { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--blue-soft); color: var(--blue); }
  .you .split-ic { background: #f3e6bd; color: var(--gold-ink); }
  .split-ic :global(svg) { width: 18px; height: 18px; }
  .split-card li { display: grid; grid-template-columns: 20px 1fr; gap: 12px; align-items: center; padding-block: 11px; border-top: 1px solid var(--line); color: var(--ink); }
  .you li { border-top-color: #eadfbd; }
  .split-card li :global(svg) { width: 18px; height: 18px; color: var(--blue); }
  .you li :global(svg) { color: var(--gold-ink); }

  .guards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); margin-top: clamp(16px, 2vw, 24px); }
  .guards li { display: grid; gap: 8px; align-content: start; padding: clamp(20px, 2.2vw, 26px); border-radius: var(--radius); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .g-icon { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--navy-700); color: var(--gold-light); margin-bottom: 6px; }
  .g-icon :global(svg) { width: 19px; height: 19px; }
  .guards p { font-size: 15.5px; color: var(--slate); }

  .tested { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: center; margin-top: clamp(16px, 2vw, 24px); padding: clamp(22px, 2.6vw, 30px); border-radius: 20px; background: var(--bg-soft); border: 1px solid var(--line); }
  .tested h3 { font-family: var(--font-display); font-weight: 480; font-size: clamp(1.3rem, 1.9vw, 1.55rem); letter-spacing: -0.02em; }
  .tested p { margin-top: 8px; color: var(--slate); max-width: 52ch; }
  .tested ul { display: flex; flex-wrap: wrap; gap: 14px 36px; }
  .tested li { display: grid; gap: 2px; }
  .tested strong { font-family: var(--font-display); font-size: 1.7rem; font-weight: 480; letter-spacing: -0.025em; color: var(--navy-700); line-height: 1.1; font-variant-numeric: lining-nums; }
  .tested span { font-size: 14px; color: var(--slate); }

  /* ---------- Process ---------- */
  .steps { --p: 1; --ring: var(--bg-soft); position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .steps::before, .steps::after { content: ''; position: absolute; left: 24px; right: calc((100% - 96px) / 5 - 24px); top: 23px; height: 2px; border-radius: 2px; }
  .steps::before { background: #dde4ec; }
  .steps::after { background: linear-gradient(90deg, var(--navy-700), var(--gold)); transform-origin: left; transform: scaleX(var(--p)); }
  .steps li { position: relative; z-index: 1; display: grid; gap: 8px; align-content: start; }
  .node { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--navy-700); color: var(--gold-light); box-shadow: 0 0 0 8px var(--ring); font-family: var(--font-head); font-weight: 600; font-size: 13.5px; font-variant-numeric: tabular-nums; transition: background 0.4s ease, color 0.4s ease, transform 0.5s var(--ease), box-shadow 0.4s ease; }
  .node b { font-weight: 600; }
  .steps h3 { margin-top: 14px; }
  .steps p { color: var(--slate); font-size: 15.5px; max-width: 26ch; }
  .steps.armed li:not(.on) .node { background: #fff; color: #9aa7b6; box-shadow: 0 0 0 8px var(--ring), inset 0 0 0 2px #dfe5ec; }
  .steps.armed li.on .node { transform: scale(1.06); box-shadow: 0 0 0 8px var(--ring), 0 12px 24px -10px rgba(24, 53, 81, 0.6); }
