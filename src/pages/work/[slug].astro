---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Shot from '../../components/Shot.astro';
import PageHero from '../../components/PageHero.astro';
import SystemVisual from '../../components/SystemVisual.astro';
import CtaBand from '../../components/CtaBand.astro';
import { systems, statusLabel, type System } from '../../data/systems';

export function getStaticPaths() {
  return systems.map((system) => ({ params: { slug: system.slug }, props: { system } }));
}
interface Props { system: System; }
const { system } = Astro.props;
const index = systems.findIndex((s) => s.slug === system.slug);
const next = systems[(index + 1) % systems.length];
const gallery = system.screens.filter((s) => s.kind === 'desktop').slice(1);
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base
  title={`${system.name}: ${system.kind.toLowerCase()}`}
  description={`${system.tagline} ${statusLabel[system.status]}. Built by MetricAscent.`}
>
  <PageHero class="case-hero">
    <a slot="top" class="back" href="/work/"><Icon name="arrow-right" /> All work <span>{num(index)} / {String(systems.length).padStart(2, '0')}</span></a>
    <Fragment slot="title">{system.name}</Fragment>
    <Fragment slot="lede">{system.tagline}</Fragment>
    {system.demo && (
      <div class="phero-actions">
        <a class="btn btn-gold" href={system.demo.href} target="_blank" rel="noopener">{system.demo.label} <Icon name="arrow-up-right" /></a>
      </div>
    )}
    <dl slot="aside" class="glass spec">
      <div><dt class="label">Status</dt><dd><span class={`status status-${system.status}`}>{statusLabel[system.status]}</span><span class="spec-note">{system.statusNote}</span></dd></div>
      <div><dt class="label">Type</dt><dd>{system.kind}</dd></div>
      <div><dt class="label">Built for</dt><dd>{system.builtFor}</dd></div>
      <div><dt class="label">Built with</dt><dd class="spec-stack">{system.stack.join(' · ')}</dd></div>
    </dl>
    <div slot="below" class="wrap">
      <div class="case-visual"><SystemVisual system={system} eager /></div>
    </div>
  </PageHero>

  <section class="facts">
    <div class="wrap">
      <ul class="bigfacts">
        {system.facts.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
      </ul>
      {system.honesty && <p class="honesty"><Icon name="eye" /><span>{system.honesty}</span></p>}
    </div>
  </section>

  <section class="sec problem">
    <div class="wrap problem-grid">
      <p class="eyebrow" data-reveal>The problem</p>
      <p class="pull" data-reveal>{system.problem}</p>
    </div>
  </section>

  <section class="sec sec-paper">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">What we built</p>
          <h2>{system.status === 'production' ? <>What the system <em>does.</em></> : <>What the system is <em>designed to do.</em></>}</h2>
        </div>
      </div>
      <ol class="rows">
        {system.built.map((b, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-top" data-reveal>
          <div>
            <p class="eyebrow">Screens</p>
            <h2>A closer <em>look.</em></h2>
          </div>
          <p>Real screens from the build. Sample data throughout.</p>
        </div>
        <div class="gallery">
          {gallery.map((screen, i) => (
            <figure data-reveal>
              <Shot screen={screen} sizes="(max-width: 900px) 92vw, 560px" />
              <figcaption><span>{num(i)}</span>{screen.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec sec-dark">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">Guardrails</p>
          <h2>Software prepares. <em>A person decides.</em></h2>
        </div>
        <p>The rules this system will not break, whatever anyone clicks.</p>
      </div>
      <ol class="rows guard">
        {system.guardrails.map((g, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{g}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <a class={`next tone-${next.slug}`} href={`/work/${next.slug}/`}>
    <div class="wrap next-in">
      <div class="next-copy">
        <p class="label">Next system</p>
        <p class="next-name">{next.name}</p>
        <p class="next-tag">{next.tagline}</p>
      </div>
      <span class="next-thumb"><SystemVisual system={next} /></span>
      <span class="arrow"><Icon name="arrow-up-right" /></span>
    </div>
  </a>

  <CtaBand title={`Need something like ${system.name}?`} text="Tell us how your business runs. We’ll mock up your system with sample data so you can click through it before any build begins." />
</Base>

<style>
  :global(.case-hero) { padding-bottom: 0; overflow: visible; display: flow-root; }
  :global(.case-hero h1) { max-width: none; font-size: clamp(3.2rem, 9vw, 8rem); letter-spacing: -0.04em; }
  :global(.case-hero .lede) { font-size: clamp(1.15rem, 1.8vw, 1.4rem); max-width: 34ch; color: var(--slate); }
  .back { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-head); font-size: 12px; font-weight: 650; letter-spacing: 0.15em; text-transform: uppercase; color: var(--slate-light); text-decoration: none; }
  .back :global(svg) { width: 15px; height: 15px; transform: rotate(180deg); transition: transform 0.25s ease; }
  .back:hover { color: var(--navy-700); }
  .back:hover :global(svg) { transform: rotate(180deg) translateX(3px); }
  .back span { margin-left: 10px; padding-left: 14px; border-left: 1px solid rgba(24, 53, 81, 0.2); color: #8a6c14; font-variant-numeric: tabular-nums; }

  .spec { margin: 0; display: grid; }
  .spec div { display: grid; grid-template-columns: 96px 1fr; gap: 16px; align-items: baseline; padding-block: 14px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .spec div:first-child { border-top: 0; padding-top: 0; }
  .spec div:last-child { padding-bottom: 0; }
  .spec dd { margin: 0; color: #fff; font-size: 15.5px; line-height: 1.45; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .spec-note { color: #a9bacc; font-size: 14px; }
  .spec-stack { color: #c5d2e0 !important; font-size: 14.5px !important; }

  .case-visual { max-width: 1040px; margin: clamp(48px, 7vw, 88px) auto -110px; position: relative; z-index: 2; }

  .facts { padding-top: 174px; padding-bottom: clamp(20px, 3vw, 40px); }
  .honesty { margin-top: 36px; display: grid; grid-template-columns: 22px 1fr; gap: 14px; padding: 18px 22px; border-radius: 14px; background: var(--blue-soft); color: #1f3f6e; font-size: 15.5px; max-width: 860px; }
  .honesty :global(svg) { width: 20px; height: 20px; margin-top: 3px; }

  .problem { padding-block: clamp(56px, 8vw, 112px); }
  .problem-grid { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); align-items: start; }
  .problem-grid .eyebrow { margin-top: 1rem; }
  .pull { font-family: var(--font-display); font-size: clamp(1.6rem, 3.2vw, 2.7rem); font-weight: 440; line-height: 1.16; letter-spacing: -0.022em; color: var(--navy-700); max-width: 26ch; text-wrap: pretty; }

  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 44px); }
  figure { margin: 0; display: grid; gap: 18px; align-content: start; }
  figcaption { display: grid; grid-template-columns: 36px 1fr; color: var(--slate); font-size: 15px; }
  figcaption span { font-family: var(--font-display); font-style: italic; color: #8a6c14; }

  .guard h3 { grid-column: 2 / -1; color: #eef3f8; font-weight: 440; font-size: clamp(1.3rem, 2.3vw, 1.85rem); line-height: 1.2; max-width: 34ch; }

  /* next system: a full-width link */
  .next { display: block; text-decoration: none; background: var(--n-bg); color: var(--n-text); transition: filter 0.4s ease; }
  .next:hover { filter: brightness(1.04); }
  .tone-asta-os { --n-bg: #ffffff; --n-text: var(--navy-700); --n-soft: var(--slate); --n-line: #e3e8ee; }
  .tone-aasta-lifespace { --n-bg: linear-gradient(140deg, #f4eee2, #ece3d2); --n-text: #2a2a22; --n-soft: #5f5946; --n-line: #dfd5bf; }
  .tone-plant-os { --n-bg: linear-gradient(160deg, #0a1524, #060d18); --n-text: #fff; --n-soft: #a9bacc; --n-line: rgba(255, 255, 255, 0.12); }
  .tone-lead-engine { --n-bg: linear-gradient(160deg, #14365a, #0d2440); --n-text: #fff; --n-soft: #b9c8d8; --n-line: rgba(255, 255, 255, 0.14); }
  .next-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px) 52px; gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(48px, 7vw, 96px); }
  .next .label { color: var(--n-soft); }
  .next-name { margin-top: 14px; font-family: var(--font-display); font-size: clamp(2.6rem, 6.4vw, 5.6rem); font-weight: 460; letter-spacing: -0.035em; line-height: 0.98; transition: transform 0.5s var(--ease); }
  .next:hover .next-name { transform: translateX(12px); }
  .next-tag { margin-top: 16px; color: var(--n-soft); font-size: 1.08rem; max-width: 44ch; }
  .next-thumb { display: block; aspect-ratio: 16 / 10.4; border-radius: 14px; overflow: hidden; border: 1px solid var(--n-line); background: rgba(127, 127, 127, 0.08); }
  .next-thumb > :global(*) { width: 132%; margin: 9% 0 0 9%; transform-origin: 0 0; transition: transform 0.7s var(--ease); }
  .next:hover .next-thumb > :global(*) { transform: scale(1.05); }

  @media (max-width: 900px) {
    .gallery, .problem-grid { grid-template-columns: 1fr; }
    .problem-grid .eyebrow { margin-top: 0; }
    .next-in { grid-template-columns: 1fr 52px; }
    .next-thumb { display: none; }
  }
  @media (max-width: 620px) {
    .case-visual { margin-bottom: -60px; }
    .facts { padding-top: 104px; }
    .spec div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
