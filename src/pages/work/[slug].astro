---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Shot from '../../components/Shot.astro';
import PageHero from '../../components/PageHero.astro';
import SystemVisual from '../../components/SystemVisual.astro';
import CtaBand from '../../components/CtaBand.astro';
import { systems, statusLabel, type System } from '../../data/systems';

export function getStaticPaths() {
  return systems.map((system) => ({ params: { slug: system.slug }, props: { system } }));
}
interface Props { system: System; }
const { system } = Astro.props;
const index = systems.findIndex((s) => s.slug === system.slug);
const next = systems[(index + 1) % systems.length];
const gallery = system.screens.filter((s) => s.kind === 'desktop').slice(1);
// Systems with several phone screens get a row of handsets as well.
const phoneScreens = system.screens.filter((s) => s.kind === 'phone');
const phones = phoneScreens.length > 1 ? phoneScreens : [];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base
  title={`${system.name}: ${system.kind.toLowerCase()}`}
  description={`${system.tagline} ${statusLabel[system.status]}. Built by MetricAscent.`}
>
  <PageHero class="case-hero">
    <a slot="top" class="back" href="/work/"><Icon name="arrow-right" /> All work <span>{num(index)} / {String(systems.length).padStart(2, '0')}</span></a>
    <Fragment slot="title">{system.name}</Fragment>
    <Fragment slot="lede">{system.tagline}</Fragment>
    {system.demo && (
      <div class="phero-actions">
        <a class="btn btn-gold" href={system.demo.href} target="_blank" rel="noopener">{system.demo.label} <Icon name="arrow-up-right" /></a>
      </div>
    )}
    <dl slot="aside" class="glass spec">
      <div><dt class="label">Status</dt><dd><span class={`status status-${system.status}`}>{statusLabel[system.status]}</span><span class="spec-note">{system.statusNote}</span></dd></div>
      <div><dt class="label">Type</dt><dd>{system.kind}</dd></div>
      <div><dt class="label">Built for</dt><dd>{system.builtFor}</dd></div>
      <div><dt class="label">Built with</dt><dd class="spec-stack">{system.stack.join(' · ')}</dd></div>
    </dl>
    <div slot="below" class="wrap">
      <div class="case-visual"><SystemVisual system={system} eager /></div>
    </div>
  </PageHero>

  <section class="facts">
    <div class="wrap">
      <ul class="stats">
        {system.facts.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
      </ul>
      {system.honesty && <p class="honesty"><Icon name="eye" /><span>{system.honesty}</span></p>}
    </div>
  </section>

  <section class="sec problem">
    <div class="wrap">
      <div class="problem-card" data-reveal>
        <p class="eyebrow">The problem</p>
        <p class="pull">{system.problem}</p>
      </div>
    </div>
  </section>

  <section class="sec sec-paper">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">What we built</p>
          <h2>{system.status === 'production' ? 'What the system does.' : 'What the system is designed to do.'}</h2>
        </div>
      </div>
      <ol class="rows">
        {system.built.map((b, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-top" data-reveal>
          <div>
            <p class="eyebrow">Screens</p>
            <h2>A closer look.</h2>
          </div>
          <p>Real screens from the build. Sample data throughout.</p>
        </div>
        <div class="gallery">
          {gallery.map((screen, i) => (
            <figure data-reveal>
              <Shot screen={screen} sizes="(max-width: 900px) 92vw, 560px" />
              <figcaption><span>{num(i)}</span>{screen.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {phones.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-top" data-reveal>
          <div>
            <p class="eyebrow">Screens</p>
            <h2>The app, in the hand.</h2>
          </div>
          <p>Real screens from the build. The homeowner, the project and every amount are sample data.</p>
        </div>
        <div class="phones">
          {phones.map((screen, i) => (
            <figure data-reveal>
              <Shot screen={screen} sizes="(max-width: 900px) 44vw, 270px" />
              <figcaption><span>{num(i)}</span>{screen.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec guard-sec">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">Guardrails</p>
          <h2>Software prepares. A person decides.</h2>
        </div>
        <p>The rules this system will not break, whatever anyone clicks.</p>
      </div>
      <ul class="rules" data-reveal>
        {system.guardrails.map((g) => <li><Icon name="check" /><span>{g}</span></li>)}
      </ul>
    </div>
  </section>

  <a class="next" href={`/work/${next.slug}/`}>
    <div class="wrap next-in">
      <div class="next-copy">
        <p class="label">Next system</p>
        <p class="next-name">{next.name}</p>
        <p class="next-tag">{next.tagline}</p>
      </div>
      <span class="next-thumb"><SystemVisual system={next} /></span>
      <span class="arrow"><Icon name="arrow-up-right" /></span>
    </div>
  </a>

  <CtaBand title={`Need something like ${system.name}?`} text="Tell us how your business runs. We’ll mock up your system with sample data so you can click through it before any build begins." />
</Base>

<style>
  :global(.case-hero) { padding-bottom: 0; overflow: visible; display: flow-root; }
  :global(.case-hero h1) { max-width: none; font-size: clamp(2.6rem, 5.4vw, 4.2rem); letter-spacing: -0.03em; }
  :global(.case-hero .lede) { max-width: 40ch; }
  .back { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-head); font-size: 12.5px; font-weight: 680; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate-light); text-decoration: none; }
  .back :global(svg) { width: 15px; height: 15px; transform: rotate(180deg); transition: transform 0.25s ease; }
  .back:hover { color: var(--navy-700); }
  .back:hover :global(svg) { transform: rotate(180deg) translateX(3px); }
  .back span { margin-left: 10px; padding-left: 14px; border-left: 1px solid var(--line); color: var(--gold-ink); font-variant-numeric: tabular-nums; }

  .spec { margin: 0; display: grid; }
  .spec div { display: grid; grid-template-columns: 96px 1fr; gap: 16px; align-items: baseline; padding-block: 13px; border-top: 1px solid var(--line); }
  .spec div:first-child { border-top: 0; padding-top: 0; }
  .spec div:last-child { padding-bottom: 0; }
  .spec dd { margin: 0; color: var(--navy-700); font-weight: 500; font-size: 15.5px; line-height: 1.45; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .spec-note { color: var(--slate); font-weight: 400; font-size: 14px; }
  .spec-stack { color: var(--slate) !important; font-weight: 400 !important; font-size: 14.5px !important; }

  .case-visual { max-width: 1040px; margin: clamp(40px, 5vw, 64px) auto -110px; position: relative; z-index: 2; }

  .facts { padding-top: 158px; }
  .honesty { margin-top: 20px; display: grid; grid-template-columns: 22px 1fr; gap: 14px; padding: 18px 22px; border-radius: 14px; background: var(--blue-soft); color: #1f3f6e; font-size: 15.5px; max-width: 860px; }
  .honesty :global(svg) { width: 20px; height: 20px; margin-top: 3px; }

  .problem { padding-block: clamp(32px, 4vw, 48px) clamp(56px, 7vw, 96px); }
  .problem-card { display: grid; gap: 14px; padding: clamp(24px, 3.2vw, 44px); border-radius: 20px; background: var(--bg-soft); border: 1px solid var(--line); }
  .pull { font-family: var(--font-display); font-size: clamp(1.3rem, 2vw, 1.65rem); font-weight: 460; line-height: 1.3; letter-spacing: -0.018em; color: var(--navy-700); max-width: 46ch; text-wrap: pretty; }

  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 44px); }
  .phones { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 3.4vw, 48px); align-items: start; }
  .phones figure:nth-child(even) { margin-top: clamp(0px, 3.6vw, 48px); }
  figure { margin: 0; display: grid; gap: 18px; align-content: start; }
  figcaption { display: grid; grid-template-columns: 36px 1fr; color: var(--slate); font-size: 15px; }
  figcaption span { font-family: var(--font-head); font-weight: 680; font-size: 13px; color: var(--gold-ink); font-variant-numeric: tabular-nums; }

  .guard-sec { border-top: 1px solid var(--line); }
  .guard-sec .rules li { background: var(--bg-soft); }

  /* next system: a full-width link */
  .next { display: block; text-decoration: none; background: var(--bg-soft); color: var(--navy-700); border-top: 1px solid var(--line); --n-soft: var(--slate); --n-line: var(--line); }
  .next-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px) 40px; gap: clamp(24px, 4vw, 56px); align-items: center; padding-block: clamp(32px, 4vw, 52px); }
  .next .label { color: var(--n-soft); }
  .next-name { margin-top: 10px; font-family: var(--font-display); font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 480; letter-spacing: -0.025em; line-height: 1.1; }
  .next-tag { margin-top: 10px; color: var(--n-soft); max-width: 44ch; }
  .next-thumb { display: block; aspect-ratio: 16 / 10.4; border-radius: 14px; overflow: hidden; border: 1px solid var(--n-line); background: #fff; }
  .next-thumb > :global(*) { width: 132%; margin: 9% 0 0 9%; transform-origin: 0 0; transition: transform 0.7s var(--ease); }
  .next:hover .next-thumb > :global(*) { transform: scale(1.05); }

  @media (max-width: 900px) {
    .gallery { grid-template-columns: 1fr; }
    .phones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .phones figure:nth-child(even) { margin-top: 0; }
    .next-in { grid-template-columns: 1fr 40px; }
    .next-thumb { display: none; }
  }
  @media (max-width: 620px) {
    .case-visual { margin-bottom: -60px; }
    .facts { padding-top: 100px; }
    .spec div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
