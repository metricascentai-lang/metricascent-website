---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { systems, statusLabel, type Status } from '../../data/systems';

// What each status label on this site means, in one line.
const legend: { status: Status; text: string }[] = [
  { status: 'production', text: 'Running a real business.' },
  { status: 'launching', text: 'Built, in final testing before go-live.' },
  { status: 'build', text: 'Being built with its first client.' },
  { status: 'demo', text: 'A clickable demo, shown before any build.' },
];
const count = (s: Status) => systems.filter((x) => x.status === s).length;
---
<Base
  title="Our work: custom AI systems we have built"
  description="Four custom systems built by MetricAscent: an operations system in production, a client app about to launch, a plant control room demo and a lead engine in build."
>
  <PageHero eyebrow="Our work">
    <Fragment slot="title">Real systems, <em>labelled honestly.</em></Fragment>
    <Fragment slot="lede">Each page says exactly where the system stands, what it does and the rules it cannot break. Every screen shows sample data.</Fragment>
    <div slot="aside" class="glass legend">
      <p class="label">How to read the labels</p>
      <ul>
        {legend.map((l) => (
          <li>
            <span class={`status status-${l.status}`}>{statusLabel[l.status]}</span>
            <span class="l-text">{l.text}</span>
            <span class="l-count">{count(l.status)}</span>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <section class="sec sec-soft list-sec">
    <div class="wrap">
      <WorkGrid />
      <p class="note list-note">Every product screen on this site shows sample data.</p>
    </div>
  </section>

  <CtaBand title="Want yours on this page?" text="Tell us how your business runs. We’ll mock up your system with sample data so you can click through it first." />
</Base>

<style>
  .legend ul { display: grid; margin-top: 12px; }
  .legend li { display: grid; grid-template-columns: 132px 1fr auto; gap: 14px; align-items: center; padding-block: 12px; border-top: 1px solid var(--line); }
  .legend .status { justify-self: start; }
  .l-text { font-size: 14.5px; line-height: 1.4; color: var(--slate); }
  .l-count { font-family: var(--font-display); font-size: 1.4rem; line-height: 1; color: var(--navy-700); font-variant-numeric: lining-nums; }
  .list-sec { padding-top: clamp(40px, 5vw, 64px); }
  .list-note { margin-top: 24px; }
  @media (max-width: 720px) {
    .legend li { grid-template-columns: 1fr auto; }
    .l-text { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
