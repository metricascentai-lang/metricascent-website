---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { systems, statusLabel } from '../data/systems';

const beliefs = [
  { title: 'Operations first, software second', text: 'A system is only as good as the understanding of the work behind it. We start from the job, the documents and the people, and write software to fit.' },
  { title: 'One business at a time', text: 'Each system is built for a single business and how it actually operates. We reuse what we have learned, never a template.' },
  { title: 'Proof you can click', text: 'We would rather show you a working screen than describe one. That is why every engagement begins with a mock-up.' },
];

// Same checkable figures as the homepage.
const figures = [
  { n: '15+', l: 'years of running operations before writing software' },
  { n: String(systems.length), l: 'systems designed, each for one business' },
  { n: '2,808', l: 'automated tests guard our first production system' },
  { n: '0', l: 'messages, approvals or payments made without a person' },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base
  title="About MetricAscent"
  description="MetricAscent is a studio that builds custom AI operations systems for owner-led businesses in India and the United States, led by an operator with 15+ years of experience."
>
  <PageHero eyebrow="About">
    <Fragment slot="title">Built by people who <em>have run the operation.</em></Fragment>
    <Fragment slot="lede">MetricAscent is a studio that builds custom AI operations systems for owner-led businesses in India and the United States.</Fragment>
  </PageHero>

  <section class="sec">
    <div class="wrap story">
      <div class="story-side" data-reveal>
        <p class="eyebrow">Why we exist</p>
        <h2>Most business software is written by people who have <em>never done the job.</em></h2>
      </div>
      <div class="story-body" data-reveal>
        <p class="lead">Our founder spent more than 15 years running operations before building software for them, and knows first-hand what it costs when the work lives in spreadsheets, inboxes and one person’s memory.</p>
        <p>That is the experience we build from. Owner-led businesses do not need another generic tool that forces them to change how they work. They need a system shaped around their own process, built by people who understand why the process exists.</p>
        <p>So that is all we do. We build one system for one business at a time, and we stay honest about what is finished and what is not.</p>
      </div>
    </div>
  </section>

  <section class="sec sec-dark fig-sec">
    <div class="wrap">
      <ul class="bigfacts" data-reveal>
        {figures.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec sec-paper">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">What we believe</p>
          <h2>Three things that <em>shape the work.</em></h2>
        </div>
      </div>
      <ol class="rows">
        {beliefs.map((b, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">What we have built</p>
          <h2>Four systems <em>so far.</em></h2>
        </div>
        <p>Each one is labelled with exactly where it stands today.</p>
      </div>
      <ul class="built-list">
        {systems.map((s) => (
          <li data-reveal>
            <a href={`/work/${s.slug}/`}>
              <span class="name">{s.name}</span>
              <span class="kind">{s.kind}</span>
              <span class={`status status-${s.status}`}>{statusLabel[s.status]}</span>
              <span class="arrow"><Icon name="arrow-up-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); row-gap: 32px; align-items: start; }
  .story-side { grid-column: 1 / 6; }
  .story-body { grid-column: 7 / -1; }
  .story-side { position: sticky; top: 128px; }
  .story-side h2 { margin-top: 18px; }
  .story-body { display: grid; gap: 22px; font-size: var(--t-lg); color: var(--slate); padding-top: 34px; }
  .story-body .lead { font-family: var(--font-display); font-size: var(--d-sm); font-weight: 440; line-height: 1.24; letter-spacing: -0.018em; color: var(--navy-700); }

  .fig-sec { padding-block: clamp(40px, 4.6vw, 60px); }
  .fig-sec .bigfacts { --rule: rgba(255, 255, 255, 0.12); border-top: 0; }
  .fig-sec .bigfacts li { padding-top: 0; }
  .fig-sec .bigfacts strong { color: #fff; }
  .fig-sec .bigfacts li:last-child strong { color: var(--gold-light); }
  .fig-sec .bigfacts span { color: #a9bacc; }

  .built-list { display: grid; border-top: 1px solid var(--line); }
  .built-list a { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: center; padding-block: clamp(14px, 1.7vw, 20px); border-bottom: 1px solid var(--line); text-decoration: none; color: var(--navy-700); }
  .built-list .name { grid-column: 1 / 7; }
  .built-list .kind { grid-column: 7 / 10; }
  .built-list .status { grid-column: 10 / 12; justify-self: start; }
  .built-list .arrow { grid-column: 12; justify-self: end; }
  .name { font-family: var(--font-display); font-weight: 470; font-size: var(--d-md); letter-spacing: -0.028em; line-height: 1.05; transition: transform 0.5s var(--ease); }
  .built-list a:hover .name { transform: translateX(10px); }
  .kind { color: var(--slate); }

  @media (max-width: 860px) {
    .story-side, .story-body { grid-column: 1 / -1; }
    .story-body { padding-top: 0; }
    .story-side { position: static; }
    .built-list a { grid-template-columns: minmax(0, 1fr) auto; row-gap: 8px; }
    .built-list .name { grid-column: 1; grid-row: 1; }
    .built-list .kind { grid-column: 1; grid-row: 2; }
    .built-list .status { grid-column: 2; grid-row: 1; justify-self: end; }
    .built-list .arrow { display: none; }
    .fig-sec .bigfacts li { padding-top: 22px; }
    .fig-sec .bigfacts li:nth-child(-n + 2) { padding-top: 0; }
  }
</style>
