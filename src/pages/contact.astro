---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';

const next = [
  { title: 'A 20-minute call', text: 'You tell us how your business runs and where it hurts. We ask questions. No slides.' },
  { title: 'A clickable mock-up', text: 'If we can help, we build a mock-up of your system with sample data for you to click through.' },
  { title: 'Your decision', text: 'You decide whether to build, with the mock-up in front of you. No pressure either way.' },
];
const direct = [
  { label: 'Email', text: site.email, href: `mailto:${site.email}`, external: false },
  { label: 'Phone', text: site.phoneDisplay, href: site.phoneHref, external: false },
  { label: 'LinkedIn', text: 'MetricAscent', href: site.linkedin, external: true },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base
  title="Contact MetricAscent: book a 20-minute call"
  description="Book a 20-minute call with MetricAscent. Tell us how your business runs and we will show you what a custom system could look like."
>
  <PageHero eyebrow="Contact">
    <Fragment slot="title">Tell us how your <em>business runs.</em></Fragment>
    <Fragment slot="lede">A 20-minute call is enough to know whether a custom system would help. If it would, we will show you one before you spend anything on a build.</Fragment>
    <div slot="aside" class="glass book">
      <p class="label">Book a call</p>
      <p class="book-big">20 <span>minutes</span></p>
      <p class="book-text">Pick a time that suits you. The call is free.</p>
      <a class="btn btn-gold" href={site.bookingUrl} target="_blank" rel="noopener">Choose a time <Icon name="arrow-up-right" /></a>
      <p class="book-note">Opens our booking page on cal.com in a new tab.</p>
    </div>
  </PageHero>

  <section class="sec direct-sec">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Or reach us directly</p>
      <ul class="direct">
        {direct.map((d) => (
          <li data-reveal>
            <a href={d.href} target={d.external ? '_blank' : undefined} rel={d.external ? 'noopener' : undefined}>
              <span class="label">{d.label}</span>
              <span class="d-text">{d.text}</span>
              <span class="arrow"><Icon name="arrow-up-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec-paper">
    <div class="wrap">
      <div class="sec-top" data-reveal>
        <div>
          <p class="eyebrow">What happens next</p>
          <h2>Three steps, and you are in control of each.</h2>
        </div>
      </div>
      <ol class="rows">
        {next.map((n, i) => (
          <li data-reveal>
            <span class="n">{num(i)}</span>
            <h3>{n.title}</h3>
            <p>{n.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .book { display: grid; gap: 12px; justify-items: start; }
  .book-big { font-family: var(--font-display); font-size: clamp(3rem, 5vw, 4rem); font-weight: 460; line-height: 0.95; letter-spacing: -0.035em; color: var(--navy-700); font-variant-numeric: lining-nums; }
  .book-big span { font-size: 0.36em; letter-spacing: -0.01em; color: var(--gold-ink); }
  .book-text { color: var(--slate); }
  .book .btn { margin-top: 6px; border-radius: 12px; }
  .book-note { font-size: 13px; color: var(--slate-light); }

  .direct-sec { padding-block: clamp(40px, 5vw, 64px); }
  .direct { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
  .direct a { position: relative; display: grid; gap: 8px; height: 100%; padding: clamp(20px, 2.2vw, 26px); padding-right: 68px; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); text-decoration: none; color: var(--navy-700); transition: border-color 0.25s ease, transform 0.35s var(--ease); }
  .direct a:hover { border-color: #cfd8e3; transform: translateY(-2px); }
  .direct .arrow { position: absolute; right: 18px; top: 18px; }
  .d-text { font-family: var(--font-display); font-weight: 480; font-size: clamp(1.2rem, 1.7vw, 1.4rem); letter-spacing: -0.02em; line-height: 1.15; overflow-wrap: anywhere; font-variant-numeric: lining-nums; }
  @media (max-width: 860px) { .direct { grid-template-columns: 1fr; } }
</style>
