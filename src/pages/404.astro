---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" description="The page you were looking for is not here.">
  <PageHero eyebrow="Error 404" class="missing">
    <Fragment slot="title">That page is <em>not here.</em></Fragment>
    <Fragment slot="lede">It may have moved when we rebuilt the site. These will get you back on track.</Fragment>
    <div class="phero-actions">
      <a class="btn btn-gold" href="/">Go to the homepage <Icon name="arrow-right" /></a>
      <a class="btn btn-ghost" href="/work/">See our work</a>
    </div>
  </PageHero>
</Base>

<style>
  :global(.missing) { min-height: 76vh; display: grid; align-items: center; }
</style>
