---
// Illustration of the Lead Engine's weekly to-do screen.
// Every company here is fictional: the real pilot holds real people and businesses.
import Icon from './Icon.astro';
const stages = [
  { n: 41, l: 'Found' }, { n: 12, l: 'Contacted' }, { n: 5, l: 'Replied' },
  { n: 2, l: 'Meeting' }, { n: 1, l: 'Sample sent' }, { n: 0, l: 'Customer' },
];
const buyers = [
  { rank: 1, name: 'Verdane Laboratoires', meta: 'Lyon, France · Contract manufacturer', score: 86, role: 'Raw materials buyer', quote: '“…preserved with a multifunctional glycerin ether…”', next: 'Email the buyer: offer a second European source.', channel: 'Email' },
  { rank: 2, name: 'Altamira Ingredients', meta: 'Milan, Italy · Distributor', score: 79, role: 'Category manager', quote: '“…distributing actives to 300+ formulators…”', next: 'Email: propose a stocked EU supply line.', channel: 'Email' },
  { rank: 3, name: 'Nordhaven Kosmetik', meta: 'Hamburg, Germany · Brand owner', score: 71, role: 'Head of purchasing', quote: '“…new sensitive-skin range launching in spring…”', next: 'Cold email needs consent here. Call, then invite to the show.', channel: 'Call' },
];
---
<div class="desk" role="img" aria-label="Illustration of the Lead Engine to-do screen with three fictional buyers, each showing a fit score, evidence and next step">
  <div class="top">
    <span class="logo"><Icon name="target" /> Lead Desk</span>
    <span class="search"><Icon name="search" /> Product, country…</span>
    <span class="sample">Sample data</span>
  </div>
  <ol class="pipe">
    {stages.map((s) => <li><b>{s.n}</b>{s.l}</li>)}
  </ol>
  <div class="body">
    <div class="list">
      <p class="label">Contact these first</p>
      {buyers.map((b) => (
        <div class="buyer">
          <span class="rank">{b.rank}</span>
          <div class="main">
            <p class="name">{b.name}</p>
            <p class="meta">{b.meta}</p>
            <p class="quote">{b.quote} <span class="src">source</span></p>
            <p class="next"><strong>Next step.</strong> {b.next}</p>
            <p class="chips"><span class="chip person">{b.role}</span><span class="chip ok"><Icon name="check" /> Email checked</span><span class="chip">{b.channel}</span></p>
          </div>
          <div class="score"><b>{b.score}</b><span>/100</span></div>
        </div>
      ))}
    </div>
    <aside class="run">
      <p class="label">This week’s search</p>
      <dl>
        <div><dt>Companies found</dt><dd>70</dd></div>
        <div><dt>Pages read</dt><dd>70</dd></div>
        <div><dt>Kept, with evidence</dt><dd class="good">13</dd></div>
        <div><dt>Dropped, with reason</dt><dd>57</dd></div>
        <div><dt>People named</dt><dd>23</dd></div>
      </dl>
      <p class="nothing"><Icon name="shield" /> Nothing sent. You check and send.</p>
    </aside>
  </div>
</div>

<style>
  .desk { background: #fff; border: 1px solid rgba(12, 30, 51, 0.12); border-radius: 14px; box-shadow: var(--shadow-lg); overflow: hidden; font-size: 13px; line-height: 1.45; color: var(--ink); text-align: left; }
  .top { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--navy-700); color: #fff; }
  .logo { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-head); font-weight: 650; font-size: 14px; }
  .logo :global(svg) { width: 17px; height: 17px; color: var(--gold-light); }
  .search { flex: 1; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 8px; background: rgba(255, 255, 255, 0.1); color: #b9c8d8; font-size: 12px; min-width: 0; white-space: nowrap; overflow: hidden; }
  .search :global(svg) { width: 13px; height: 13px; flex: none; }
  .sample { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--gold); color: var(--navy-900); padding: 4px 9px; border-radius: 999px; white-space: nowrap; }
  .pipe { display: flex; gap: 6px; padding: 12px 16px; background: var(--bg-soft); border-bottom: 1px solid var(--line); overflow: hidden; }
  .pipe li { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 7px 9px; border-radius: 9px; background: #fff; border: 1px solid var(--line); font-size: 10.5px; color: var(--slate); white-space: nowrap; }
  .pipe b { font-family: var(--font-head); font-size: 16px; color: var(--navy-700); line-height: 1.2; }
  .pipe li:first-child { border-color: var(--gold); background: var(--gold-soft); }
  .body { display: grid; grid-template-columns: 1fr 190px; }
  .list { padding: 14px 16px 16px; display: grid; gap: 10px; }
  .label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate-light); }
  .buyer { display: grid; grid-template-columns: 26px 1fr auto; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: 11px; }
  .rank { width: 26px; height: 26px; border-radius: 50%; background: var(--navy-700); color: #fff; display: grid; place-items: center; font-family: var(--font-head); font-weight: 650; font-size: 12px; }
  .name { font-family: var(--font-head); font-weight: 650; font-size: 14.5px; color: var(--navy-700); }
  .meta { color: var(--slate-light); font-size: 11.5px; }
  .quote { margin-top: 6px; font-style: italic; color: var(--slate); font-size: 12px; }
  .src { font-style: normal; font-family: var(--font-mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; background: var(--blue-soft); color: var(--blue); padding: 2px 6px; border-radius: 4px; margin-left: 4px; }
  .next { margin-top: 6px; font-size: 12px; }
  .chips { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--line); font-size: 10.5px; color: var(--slate); }
  .chip.ok { background: var(--green-soft); border-color: transparent; color: var(--green); }
  .chip.ok :global(svg) { width: 11px; height: 11px; }
  .chip.person { background: var(--navy-700); border-color: transparent; color: #fff; }
  .score { text-align: right; font-family: var(--font-head); color: var(--navy-700); white-space: nowrap; }
  .score b { font-size: 24px; font-weight: 720; letter-spacing: -0.03em; }
  .score span { font-size: 11px; color: var(--slate-light); }
  .run { background: var(--navy-800); color: #c8d5e3; padding: 14px 16px 16px; }
  .run .label { color: var(--gold-light); }
  dl { margin: 12px 0 0; display: grid; gap: 9px; }
  dl div { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; border-bottom: 1px dashed rgba(255, 255, 255, 0.13); padding-bottom: 8px; }
  dt { font-size: 11.5px; }
  dd { margin: 0; font-family: var(--font-head); font-weight: 650; font-size: 15px; color: #fff; }
  dd.good { color: #7fd9ad; }
  .nothing { margin-top: 14px; display: grid; grid-template-columns: 16px 1fr; gap: 8px; font-size: 11.5px; color: #fff; }
  .nothing :global(svg) { width: 15px; height: 15px; color: var(--gold-light); margin-top: 1px; }
  @media (max-width: 620px) {
    .body { grid-template-columns: 1fr; }
    .pipe li:nth-child(n + 5) { display: none; }
    .buyer:nth-child(n + 4) { display: none; }
    .search { display: none; }
    .sample { margin-left: auto; }
  }
</style>
