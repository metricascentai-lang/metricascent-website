---
/**
 * The white hero used on every inner page. Styles live in src/styles/pages.css
 * because the title, lede and aside are passed in as slots.
 *
 *   <PageHero eyebrow="Our work">
 *     <Fragment slot="title">Real systems, <em>labelled honestly.</em></Fragment>
 *     <Fragment slot="lede">…</Fragment>
 *     <div slot="aside">…</div>
 *   </PageHero>
 */
interface Props { eyebrow?: string; class?: string; }
const { eyebrow, class: className } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['phero', className]}>
  <div class="phero-bg" aria-hidden="true">
    <i class="orb o1"></i><i class="orb o2"></i><i class="orb o3"></i><i class="mesh"></i><i class="grain"></i>
  </div>
  <div class:list={['wrap', 'phero-grid', { 'has-aside': hasAside }]}>
    <div class="phero-main">
      <slot name="top" />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1><slot name="title" /></h1>
      {Astro.slots.has('lede') && <p class="lede"><slot name="lede" /></p>}
      <slot />
    </div>
    {hasAside && <div class="phero-aside"><slot name="aside" /></div>}
  </div>
  <slot name="below" />
</section>
