---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; }
const {
  title = 'See your system before you pay for it.',
  text = 'Tell us how your business runs. We’ll show you what it could look like, as a clickable mock-up with sample data.',
} = Astro.props;
---
<section class="cta-sec">
  <div class="wrap">
    <div class="cta-band" data-reveal>
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-gold" href="/contact/">Book a 30-minute call <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost" href="/work/">See the work</a>
      </div>
    </div>
  </div>
</section>
