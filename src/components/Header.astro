---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
const mobileNav = [...nav, { href: '/contact/', label: 'Contact' }];
---
<header class="site-header" data-header>
  <div class="shell">
    <div class="bar">
      <a class="brand" href="/" aria-label="MetricAscent home">
        <Logo />
      </a>
      <nav class="desktop-nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}</span></a>
        ))}
      </nav>
      <a class="btn btn-navy header-cta" href="/contact/">Book a call <Icon name="arrow-right" /></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Menu</span>
        <span class="open"><Icon name="menu" /></span>
        <span class="close"><Icon name="x" /></span>
      </button>
    </div>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
      <ul>
        {mobileNav.map((item, i) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <i>{String(i + 1).padStart(2, '0')}</i>
              <span>{item.label}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-navy" href="/contact/">Book a call <Icon name="arrow-right" /></a>
      <a class="mobile-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    burger?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
    header?.classList.toggle('open', open);
  };
  burger?.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') { setOpen(false); burger.focus(); }
  });
  // Clear at the top of the page; a solid white bar once the page has scrolled.
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* A solid white bar across the full width, so nothing shows through it while scrolling.
     The logo is navy and gold on transparent and needs this light surface. */
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 100; background: #fff; border-bottom: 1px solid #e3e8ee; box-shadow: 0 10px 30px -18px rgba(8, 20, 36, 0.35); transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
  .shell { position: relative; max-width: calc(1260px + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }
  /* a thin gold line along the lower edge of the bar */
  .site-header::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: linear-gradient(90deg, transparent, var(--gold) 20%, var(--gold-light) 50%, var(--gold) 80%, transparent); opacity: 0.8; pointer-events: none; transition: opacity 0.3s ease; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; min-height: 68px; transition: min-height 0.45s var(--ease); }
  .brand { justify-self: start; display: block; margin-left: -8px; border-radius: 8px; --logo-width: 208px; }
  .brand :global(img) { transition: width 0.45s var(--ease); }

  .desktop-nav { display: flex; gap: 4px; }
  .desktop-nav a { font-family: var(--font-head); font-size: 15px; font-weight: 560; color: #3c4d61; text-decoration: none; padding: 10px 16px; border-radius: 10px; transition: color 0.2s ease; }
  .desktop-nav a span { position: relative; display: block; }
  .desktop-nav a span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease); }
  .desktop-nav a:hover, .desktop-nav a[aria-current='page'] { color: var(--navy-700); }
  .desktop-nav a:hover span::after, .desktop-nav a[aria-current='page'] span::after { transform: scaleX(1); }

  .header-cta { justify-self: end; min-height: 44px; padding: 8px 16px 8px 20px; border-radius: 12px; font-size: 14.5px; }
  .header-cta :global(svg) { width: 16px; height: 16px; color: var(--gold-light); }

  .burger { display: none; justify-self: end; width: 44px; height: 44px; border: 1px solid #d8dee6; border-radius: 12px; background: #fff; color: var(--navy-700); cursor: pointer; place-items: center; }
  .burger :global(svg) { width: 22px; height: 22px; }
  .burger .close { display: none; }
  .burger[aria-expanded='true'] .open { display: none; }
  .burger[aria-expanded='true'] .close { display: block; }

  /* At the very top of the page the bar is clear and a little taller, sitting on the white hero. */
  :global(.js) .site-header:not(.scrolled):not(.open) { background: transparent; border-bottom-color: transparent; box-shadow: none; }
  :global(.js) .site-header:not(.scrolled):not(.open)::after { opacity: 0; }
  :global(.js) .site-header:not(.scrolled):not(.open) .bar { min-height: 92px; }
  :global(.js) .site-header:not(.scrolled):not(.open) .brand { --logo-width: 236px; }

  .mobile-menu { display: grid; padding: 4px 0 24px; border-top: 1px solid #e3e8ee; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu li a { display: grid; grid-template-columns: 34px 1fr auto; align-items: baseline; padding: 15px 2px; border-bottom: 1px solid #e3e8ee; color: var(--navy-700); text-decoration: none; }
  .mobile-menu li i { font-family: var(--font-display); font-style: italic; font-size: 15px; color: #8a6c14; font-variant-numeric: lining-nums; }
  .mobile-menu li span { font-family: var(--font-display); font-size: 1.9rem; font-weight: 460; letter-spacing: -0.025em; line-height: 1.1; }
  .mobile-menu li a[aria-current='page'] span { font-style: italic; color: #8a6c14; }
  .mobile-menu li :global(svg) { width: 20px; height: 20px; align-self: center; color: #8d98a6; }
  .mobile-menu .btn { margin-top: 22px; }
  .mobile-menu .btn :global(svg) { color: var(--gold-light); }
  .mobile-menu .mobile-mail { margin-top: 16px; text-align: center; font-size: 15px; color: var(--slate); text-decoration: none; }

  @media (max-width: 820px) {
    .desktop-nav, .header-cta { display: none; }
    .burger { display: grid; }
    .bar, :global(.js) .site-header:not(.scrolled):not(.open) .bar { grid-template-columns: 1fr auto; min-height: 62px; }
    .brand, :global(.js) .site-header:not(.scrolled):not(.open) .brand { --logo-width: 186px; }
  }
  @media (min-width: 821px) { .mobile-menu { display: none; } }
</style>
