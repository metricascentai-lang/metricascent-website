---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="pill">
    <div class="bar">
      <a class="brand" href="/" aria-label="MetricAscent home">
        <Image src={logo} alt="MetricAscent: Smarter Systems, Higher Gains" width={200} loading="eager" />
      </a>
      <nav class="desktop-nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="btn btn-navy header-cta" href="/contact/">Book a call <Icon name="arrow-right" /></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Menu</span>
        <span class="open"><Icon name="menu" /></span>
        <span class="close"><Icon name="x" /></span>
      </button>
    </div>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-navy" href="/contact/">Book a call</a>
      <a class="mobile-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  // Tighten the floating bar once the page has scrolled.
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 100; padding: 14px var(--gutter) 0; pointer-events: none; transition: padding 0.35s var(--ease); }
  .site-header.scrolled { padding-top: 8px; }
  .pill {
    pointer-events: auto; max-width: var(--wrap); margin-inline: auto; border-radius: 20px;
    background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(1.6) blur(18px); -webkit-backdrop-filter: saturate(1.6) blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 18px 44px -18px rgba(4, 9, 18, 0.55), 0 2px 8px rgba(4, 9, 18, 0.12);
  }
  .bar { display: flex; align-items: center; gap: 28px; min-height: 64px; padding-inline: 22px 12px; }
  .brand { display: block; flex: none; }
  .brand :global(img) { width: clamp(138px, 14vw, 172px); height: auto; }
  .desktop-nav { display: flex; gap: 6px; margin-left: auto; }
  .desktop-nav a { position: relative; font-family: var(--font-head); font-size: 14.5px; font-weight: 560; color: var(--navy-700); text-decoration: none; padding: 9px 14px; border-radius: 10px; transition: background 0.2s ease; }
  .desktop-nav a:hover { background: rgba(24, 53, 81, 0.07); }
  .desktop-nav a[aria-current='page']::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 3px; height: 2px; border-radius: 2px; background: var(--gold); }
  .header-cta { min-height: 42px; padding: 8px 16px; border-radius: 12px; font-size: 14.5px; }
  .header-cta :global(svg) { width: 16px; height: 16px; }
  .burger { display: none; margin-left: auto; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--navy-700); cursor: pointer; place-items: center; }
  .burger :global(svg) { width: 22px; height: 22px; }
  .burger .close { display: none; }
  .burger[aria-expanded='true'] .open { display: none; }
  .burger[aria-expanded='true'] .close { display: block; }
  .mobile-menu { display: grid; gap: 2px; padding: 4px 22px 22px; border-top: 1px solid var(--line); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a:not(.btn) { font-family: var(--font-head); font-size: 17px; font-weight: 600; color: var(--navy-700); text-decoration: none; padding: 14px 2px; border-bottom: 1px solid var(--line); }
  .mobile-menu .btn { margin-top: 16px; }
  .mobile-menu .mobile-mail { border-bottom: 0 !important; font-family: var(--font-body) !important; font-weight: 400 !important; font-size: 15px !important; color: var(--slate) !important; }
  @media (max-width: 820px) {
    .desktop-nav, .header-cta { display: none; }
    .burger { display: grid; }
    .bar { min-height: 58px; padding-inline: 16px 8px; }
    .site-header { padding-top: 10px; }
  }
  @media (min-width: 821px) { .mobile-menu { display: none; } }
</style>
