---
// The MetricAscent logo, exactly as supplied (src/assets/logo.webp). Do not redraw or recolour it.
// The artwork is navy and gold on a transparent background, so it must sit on a light surface.
// Size it with --logo-width on a parent.
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
---
<Image class="logo" src={logo} alt="MetricAscent: Smarter Systems, Higher Gains" widths={[240, 420, logo.width]} sizes="260px" loading="eager" />

<style>
  .logo { display: block; width: var(--logo-width, 190px); height: auto; max-width: none; }
</style>
