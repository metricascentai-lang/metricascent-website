---
// The MetricAscent logo as vector and live type, so it stays sharp at any size.
// Two measured bars, and a third that turns into a rising gold arrow:
// "Metric" in the text colour, "Ascent" in gold, the same split as the wordmark.
interface Props { id?: string; }
const { id = 'logo' } = Astro.props;
---
<span class="logo">
  <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${id}-gold`} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#b98d2c" />
        <stop offset="0.55" stop-color="#d8b452" />
        <stop offset="1" stop-color="#f1d894" />
      </linearGradient>
    </defs>
    <rect x="3.5" y="24" width="8" height="13" rx="1.7" fill="currentColor" />
    <rect x="15" y="16" width="8" height="21" rx="1.7" fill="currentColor" />
    <path d="M27.5 36.2V15.6H23.9L31 4.2L38.1 15.6H34.5V36.2Z" fill={`url(#${id}-gold)`} stroke={`url(#${id}-gold)`} stroke-width="1.6" stroke-linejoin="round" />
  </svg>
  <span class="logo-word">Metric<span>Ascent</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.46em; font-size: var(--logo-size, 21px); line-height: 1; color: inherit; }
  .logo-mark { width: 1.5em; height: 1.5em; flex: none; margin-top: -0.14em; }
  .logo-word { font-family: var(--font-head); font-weight: 680; letter-spacing: -0.028em; white-space: nowrap; }
  .logo-word span { color: var(--logo-accent, var(--gold-light)); }
</style>
