---
/**
 * The four systems as large cards that stack over one another while scrolling.
 * The stacking is plain CSS (position: sticky); the script only adds depth by
 * easing a covered card back. On small or short screens the cards simply flow.
 */
import Icon from '../Icon.astro';
import SystemVisual from '../SystemVisual.astro';
import { systems, statusLabel } from '../../data/systems';

const total = String(systems.length).padStart(2, '0');
---
<section class="work" id="work">
  <div class="wrap">
    <div class="work-head">
      <div data-reveal>
        <p class="eyebrow">Selected work</p>
        <h2>Four systems. <span class="serif">Each one labelled honestly.</span></h2>
      </div>
      <div class="work-intro" data-reveal>
        <p>One is in production, one is about to launch, two are earlier. We say which is which, and every screen shows sample data.</p>
        <a class="text-link" href="/work/">All work <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="stack" data-stack>
      {systems.map((s, i) => (
        <article class={`wcard tone-${s.slug}`} style={`--i:${i}`} data-card>
          <div class="wcard-in">
            <div class="copy">
              <p class="idx"><b>{String(i + 1).padStart(2, '0')}</b> / {total}</p>
              <p class="meta"><span class={`status status-${s.status}`}>{statusLabel[s.status]}</span><span class="kind">{s.kind}</span></p>
              <h3>{s.name}</h3>
              <p class="tagline">{s.tagline}</p>
              <ul class="hl">
                {s.highlights.map((h) => <li><Icon name="check" /><span>{h}</span></li>)}
              </ul>
              <p class="for"><span>Built for</span> {s.builtFor}</p>
              <a class="more" href={`/work/${s.slug}/`}>Read the case study <i><Icon name="arrow-up-right" /></i></a>
            </div>
            <div class="vis"><SystemVisual system={s} /></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const pinned = window.matchMedia('(min-width: 1000px) and (min-height: 700px)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (stack) {
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('[data-card]'));
    let ticking = false;
    const update = () => {
      ticking = false;
      const on = pinned.matches && !calm.matches;
      cards.forEach((card, i) => {
        const inner = card.firstElementChild as HTMLElement;
        const next = cards[i + 1];
        if (!on || !next) { inner.style.transform = ''; inner.style.filter = ''; inner.style.boxShadow = ''; return; }
        // how far the next card has slid over this one: 0 = not at all, 1 = fully
        const a = card.getBoundingClientRect();
        const b = next.getBoundingClientRect();
        const cover = Math.min(1, Math.max(0, (a.bottom - b.top) / a.height));
        inner.style.transform = `scale(${(1 - cover * 0.055).toFixed(4)})`;
        inner.style.filter = cover > 0.01 ? `brightness(${(1 - cover * 0.28).toFixed(3)})` : '';
        inner.style.boxShadow = cover > 0.5 ? 'none' : '';
      });
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  .work { background: var(--paper); padding-block: clamp(72px, 10vw, 136px) clamp(48px, 7vw, 96px); }
  .work-head { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(24px, 5vw, 72px); align-items: end; margin-bottom: clamp(36px, 5vw, 64px); }
  .work-head h2 { margin-top: 18px; max-width: 14ch; }
  .work-head h2 .serif { color: #8a6c14; font-size: 1.08em; }
  .work-intro { display: grid; gap: 18px; justify-items: start; }
  .work-intro p { color: var(--slate); font-size: 1.1rem; }

  .stack { display: grid; gap: 28px; }
  .wcard-in {
    display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 4vw, 64px); align-items: center;
    padding: clamp(26px, 4.2vw, 60px); border-radius: 30px; overflow: hidden; transform-origin: 50% 0; will-change: transform;
    background: var(--c-bg); color: var(--c-text); border: 1px solid var(--c-line);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.5) inset, 0 40px 80px -48px rgba(8, 20, 36, 0.5);
  }
  .tone-asta-os { --c-bg: #ffffff; --c-text: var(--slate); --c-head: var(--navy-700); --c-line: #e6e2d8; --c-soft: var(--slate-light); --c-accent: #806414; }
  .tone-aasta-lifespace { --c-bg: linear-gradient(140deg, #f4eee2, #ece3d2); --c-text: #55503f; --c-head: #2a2a22; --c-line: #dfd5bf; --c-soft: #6b644f; --c-accent: #7a5c0c; }
  .tone-plant-os { --c-bg: radial-gradient(700px 420px at 90% 0%, rgba(124, 196, 255, 0.13), transparent 60%), linear-gradient(160deg, #0a1524, #060d18); --c-text: #a9bacc; --c-head: #fff; --c-line: rgba(255, 255, 255, 0.1); --c-soft: #8598ad; --c-accent: var(--sys); }
  .tone-lead-engine { --c-bg: radial-gradient(700px 420px at 0% 100%, rgba(201, 162, 63, 0.2), transparent 60%), linear-gradient(160deg, #14365a, #0d2440); --c-text: #b9c8d8; --c-head: #fff; --c-line: rgba(255, 255, 255, 0.12); --c-soft: #93a6ba; --c-accent: var(--gold-light); }

  .copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .idx { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.14em; color: var(--c-soft); }
  .idx b { font-weight: 500; color: var(--c-accent); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .kind { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-soft); }
  .copy h3 { font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 680; letter-spacing: -0.04em; line-height: 1.02; color: var(--c-head); }
  .tagline { font-size: 1.1rem; line-height: 1.55; }
  .hl { display: grid; gap: 9px; margin-block: 2px; }
  .hl li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: start; color: var(--c-head); font-size: 15.5px; }
  .hl :global(svg) { width: 17px; height: 17px; margin-top: 4px; color: var(--c-accent); stroke-width: 2.6; }
  .for { font-size: 14px; color: var(--c-soft); padding-top: 14px; border-top: 1px solid var(--c-line); width: 100%; }
  .for span { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; margin-right: 8px; }
  .more { display: inline-flex; align-items: center; gap: 12px; margin-top: 4px; font-family: var(--font-head); font-weight: 620; font-size: 15.5px; color: var(--c-head); text-decoration: none; }
  .more i { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--c-line); transition: background 0.25s ease, color 0.25s ease, transform 0.35s var(--ease), border-color 0.25s ease; }
  .more :global(svg) { width: 17px; height: 17px; }
  .more:hover i { background: var(--gold); border-color: var(--gold); color: var(--navy-900); transform: rotate(45deg); }
  .vis { min-width: 0; }
  /* the Lead Desk illustration is tall: show its top and fade the rest */
  .tone-lead-engine .vis { max-height: 500px; overflow: hidden; border-radius: 14px; mask-image: linear-gradient(180deg, #000 76%, transparent); }
  .wcard:hover .vis { transform: translateY(-4px); }
  .vis { transition: transform 0.6s var(--ease); }

  @media (min-width: 1000px) and (min-height: 700px) {
    .stack { gap: 0; }
    .wcard { position: sticky; top: calc(96px + var(--i) * 16px); padding-bottom: 36px; }
    .wcard:last-child { padding-bottom: 0; }
    .wcard-in { min-height: min(620px, calc(100vh - 190px)); }
  }
  @media (max-width: 999px) {
    .work-head, .wcard-in { grid-template-columns: 1fr; }
    .wcard-in { border-radius: 22px; }
    .vis { order: -1; }
  }
</style>
