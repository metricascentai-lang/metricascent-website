---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { systems, statusLabel } from '../data/systems';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="about">
      <a class="home" href="/" aria-label="MetricAscent home"><Logo /></a>
      <p class="blurb">Custom AI operations systems for owner-led businesses, <em>built around how you already work.</em></p>
      <a class="mail" href={`mailto:${site.email}`}>
        <span>{site.email}</span>
        <i class="go"><Icon name="arrow-up-right" /></i>
      </a>
    </div>

    <div class="cols">
      <nav aria-label="Systems">
        <h2>Systems</h2>
        <ul>
          {systems.map((s) => (
            <li>
              <a href={`/work/${s.slug}/`}>{s.name}</a>
              <small class={`st st-${s.status}`}>{statusLabel[s.status]}</small>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/work/">Work</a></li>
          <li><a href="/approach/">Approach</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div>
        <h2>Talk to us</h2>
        <ul class="contact">
          <li><Icon name="phone" /><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li><Icon name="calendar" /><a href="/contact/">Book a 20-minute call</a></li>
          <li><Icon name="linkedin" /><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><Icon name="instagram" /><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap legal">
    <p>&copy; {year} MetricAscent. All rights reserved.</p>
    <p>Every product screen on this site shows sample data.</p>
    <a class="up" href="#">Back to top <Icon name="arrow-up-right" /></a>
  </div>
</footer>

<style>
  /* A light footer: the logo is navy and gold on transparent and needs a light surface. */
  .site-footer { position: relative; isolation: isolate; overflow: hidden; background: var(--paper); color: var(--slate); padding-top: clamp(64px, 8vw, 112px); font-size: 15.5px; border-top: 1px solid #e6e0d2; }
  .site-footer::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(720px 420px at 4% 0%, rgba(44, 95, 168, 0.07), transparent 62%), radial-gradient(760px 460px at 98% 100%, rgba(201, 162, 63, 0.2), transparent 62%); }

  .top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); row-gap: 48px; align-items: start; }
  .about { grid-column: 1 / 6; }
  .cols { grid-column: 7 / -1; }
  .home { display: inline-block; margin: -30px 0 0 -8px; border-radius: 8px; --logo-width: 268px; }
  .blurb { margin-top: 18px; max-width: 20ch; font-family: var(--font-display); font-size: clamp(1.6rem, 2.7vw, 2.3rem); font-weight: 440; line-height: 1.12; letter-spacing: -0.024em; color: var(--navy-700); }
  .blurb em { font-style: italic; font-weight: 420; color: #8a6c14; }
  .mail { display: inline-flex; align-items: center; gap: 16px; margin-top: 32px; color: var(--navy-700); font-family: var(--font-head); font-weight: 580; font-size: clamp(1.02rem, 1.5vw, 1.2rem); }
  .mail span { border-bottom: 2px solid var(--gold); padding-bottom: 3px; }
  .mail .go { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; border: 1px solid rgba(24, 53, 81, 0.3); transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.45s var(--ease); }
  .mail .go :global(svg) { width: 18px; height: 18px; }
  .mail:hover .go { background: var(--navy-700); border-color: var(--navy-700); color: var(--gold-light); transform: rotate(45deg); }

  .cols { display: grid; grid-template-columns: 1.45fr 0.7fr 1.25fr; gap: clamp(24px, 3vw, 48px); padding-top: 6px; }
  h2 { font-family: var(--font-head); font-size: 11.5px; font-weight: 650; letter-spacing: 0.16em; text-transform: uppercase; color: #806414; padding-bottom: 16px; margin-bottom: 6px; border-bottom: 1px solid #ddd6c6; }
  ul { display: grid; }
  li { padding-block: 9px; }
  a { text-decoration: none; }
  li a { color: var(--navy-700); font-family: var(--font-head); font-weight: 560; }
  li a:hover { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  nav[aria-label='Systems'] li { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 12px; }
  .st { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--slate-light); white-space: nowrap; }
  .st::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .st-production::before { background: var(--green); }
  .st-launching::before { background: var(--gold); }
  .st-build::before { background: var(--violet); }
  .st-demo::before { background: var(--blue); }
  .contact li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: center; }
  .contact :global(svg) { width: 17px; height: 17px; color: #8a6c14; }


  .legal { position: relative; margin-top: clamp(48px, 6vw, 80px); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 32px; padding-block: 22px; font-size: 13.5px; color: var(--slate-light); }
  .legal::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: rgba(24, 53, 81, 0.14); }
  .up { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--navy-700); font-family: var(--font-head); font-weight: 580; }
  .up :global(svg) { width: 15px; height: 15px; transform: rotate(-45deg); color: #8a6c14; }
  .up:hover { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }

  @media (max-width: 980px) {
    .about, .cols { grid-column: 1 / -1; }
    .blurb { max-width: 24ch; }
  }
  @media (max-width: 620px) {
    .cols { grid-template-columns: 1fr 1fr; row-gap: 36px; }
    .cols > :first-child { grid-column: 1 / -1; }
    .home { --logo-width: 232px; margin-top: -24px; }
    .up { margin-left: 0; }
  }
</style>
