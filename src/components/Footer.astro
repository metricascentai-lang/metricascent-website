---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { systems, statusLabel } from '../data/systems';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="about">
      <a class="home" href="/" aria-label="MetricAscent home"><Logo id="ftr-logo" /></a>
      <p class="blurb">Custom AI operations systems for owner-led businesses, <em>built around how you already work.</em></p>
      <a class="mail" href={`mailto:${site.email}`}>
        <span>{site.email}</span>
        <i class="go"><Icon name="arrow-up-right" /></i>
      </a>
    </div>

    <div class="cols">
      <nav aria-label="Systems">
        <h2>Systems</h2>
        <ul>
          {systems.map((s) => (
            <li>
              <a href={`/work/${s.slug}/`}>{s.name}</a>
              <small class={`st st-${s.status}`}>{statusLabel[s.status]}</small>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/work/">Work</a></li>
          <li><a href="/approach/">Approach</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div>
        <h2>Talk to us</h2>
        <ul class="contact">
          <li><Icon name="phone" /><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li><Icon name="calendar" /><a href="/contact/">Book a 20-minute call</a></li>
          <li><Icon name="linkedin" /><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><Icon name="instagram" /><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap sign" aria-hidden="true">
    <p>Metric<span>Ascent</span></p>
  </div>

  <div class="wrap legal">
    <p>&copy; {year} MetricAscent. All rights reserved.</p>
    <p>Every product screen on this site shows sample data.</p>
    <a class="up" href="#">Back to top <Icon name="arrow-up-right" /></a>
  </div>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; overflow: hidden; background: var(--ink-950); color: #9fb0c3; padding-top: clamp(64px, 8vw, 112px); font-size: 15.5px; }
  .site-footer::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(720px 420px at 8% 0%, rgba(124, 196, 255, 0.11), transparent 62%), radial-gradient(760px 460px at 96% 100%, rgba(201, 162, 63, 0.16), transparent 62%); }

  .top { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .home { display: inline-flex; color: #fff; border-radius: 8px; --logo-size: 28px; }
  .blurb { margin-top: 26px; max-width: 20ch; font-family: var(--font-display); font-size: clamp(1.6rem, 2.7vw, 2.3rem); font-weight: 440; line-height: 1.12; letter-spacing: -0.024em; color: #fff; }
  .blurb em { font-style: italic; font-weight: 420; background: linear-gradient(100deg, #f1d894 0%, #d8b452 45%, #b98d2c 100%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.08em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .mail { display: inline-flex; align-items: center; gap: 16px; margin-top: 32px; color: #fff; font-family: var(--font-head); font-weight: 560; font-size: clamp(1.02rem, 1.5vw, 1.2rem); }
  .mail span { border-bottom: 1.5px solid var(--gold); padding-bottom: 3px; }
  .mail .go { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; border: 1px solid rgba(255, 255, 255, 0.28); transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.45s var(--ease); }
  .mail .go :global(svg) { width: 18px; height: 18px; }
  .mail:hover .go { background: var(--gold); border-color: var(--gold); color: var(--navy-900); transform: rotate(45deg); }

  .cols { display: grid; grid-template-columns: 1.45fr 0.7fr 1.25fr; gap: clamp(24px, 3vw, 48px); padding-top: 6px; }
  h2 { font-family: var(--font-head); font-size: 11.5px; font-weight: 650; letter-spacing: 0.17em; text-transform: uppercase; color: var(--gold-light); padding-bottom: 16px; margin-bottom: 6px; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  ul { display: grid; }
  li { padding-block: 9px; }
  a { text-decoration: none; }
  li a { color: #dbe5ef; font-family: var(--font-head); font-weight: 520; transition: color 0.2s ease; }
  li a:hover { color: #fff; text-decoration: underline; text-decoration-color: var(--gold-light); text-underline-offset: 5px; }
  nav[aria-label='Systems'] li { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 12px; }
  .st { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: #8498ae; white-space: nowrap; }
  .st::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .st-production::before { background: #4ade80; }
  .st-launching::before { background: var(--gold-light); }
  .st-build::before { background: #a78bfa; }
  .st-demo::before { background: var(--sys); }
  .contact li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: center; }
  .contact :global(svg) { width: 17px; height: 17px; color: var(--gold-light); }

  /* Oversized wordmark as the sign-off. Decorative: the real logo is above. */
  .sign { container-type: inline-size; margin-top: clamp(48px, 7vw, 96px); user-select: none; }
  .sign p { font-family: var(--font-head); font-weight: 700; font-size: 16.2cqw; line-height: 0.8; letter-spacing: -0.045em; white-space: nowrap; margin-bottom: -0.085em; background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.015) 88%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sign span { background: linear-gradient(180deg, rgba(225, 189, 99, 0.6), rgba(225, 189, 99, 0.03) 88%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .legal { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 32px; padding-block: 22px; font-size: 13.5px; color: #8296ac; }
  .legal::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: rgba(255, 255, 255, 0.1); }
  .up { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: #dbe5ef; font-family: var(--font-head); font-weight: 560; }
  .up :global(svg) { width: 15px; height: 15px; transform: rotate(-45deg); color: var(--gold-light); }
  .up:hover { color: #fff; }

  @media (max-width: 980px) {
    .top { grid-template-columns: 1fr; }
    .blurb { max-width: 24ch; }
  }
  @media (max-width: 620px) {
    .cols { grid-template-columns: 1fr 1fr; row-gap: 36px; }
    .cols > :first-child { grid-column: 1 / -1; }
    .home { --logo-size: 25px; }
    .up { margin-left: 0; }
  }
</style>
