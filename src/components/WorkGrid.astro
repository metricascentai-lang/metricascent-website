---
/**
 * The four systems as one grid of identical cards: picture, status, name, one line, link.
 * Used on the homepage and on the Work page so a system always looks the same.
 */
import Icon from './Icon.astro';
import SystemVisual from './SystemVisual.astro';
import { systems, statusLabel } from '../data/systems';
---
<ul class="grid">
  {systems.map((s) => (
    <li data-reveal>
      <a class={`wcard tone-${s.slug}`} href={`/work/${s.slug}/`}>
        <span class="thumb"><SystemVisual system={s} sizes="(max-width: 820px) 92vw, 600px" /></span>
        <span class="body">
          <span class="top">
            <span class="kind">{s.kind}</span>
            <span class={`status status-${s.status}`}>{statusLabel[s.status]}</span>
          </span>
          <span class="name">{s.name}</span>
          <span class="tagline">{s.tagline}</span>
          <span class="foot">
            <span class="for">Built for {s.builtFor.charAt(0).toLowerCase() + s.builtFor.slice(1)}</span>
            <span class="more">Case study <Icon name="arrow-right" /></span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 24px); }
  .grid li { display: grid; }
  .wcard { display: grid; grid-template-rows: auto 1fr; text-decoration: none; color: var(--slate); background: #fff; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-sm); transition: transform 0.35s var(--ease), box-shadow 0.35s ease, border-color 0.25s ease; }
  .wcard:hover { transform: translateY(-4px); border-color: #cfd8e3; box-shadow: 0 2px 4px rgba(12, 30, 51, 0.04), 0 28px 48px -28px rgba(12, 30, 51, 0.35); }

  /* the picture: the top of the system's main screen on a quiet tint */
  .thumb { position: relative; display: block; aspect-ratio: 16 / 8.2; overflow: hidden; padding: clamp(16px, 2vw, 26px) clamp(16px, 2vw, 26px) 0; background: var(--t-bg, #eef2f7); }
  .thumb::after { content: ''; position: absolute; inset: auto 0 0 0; height: 36px; background: linear-gradient(180deg, transparent, rgba(8, 20, 36, 0.1)); pointer-events: none; }
  .thumb > :global(*) { transition: transform 0.6s var(--ease); transform-origin: 50% 0; }
  .wcard:hover .thumb > :global(*) { transform: scale(1.03); }
  .tone-asta-os { --t-bg: linear-gradient(160deg, #e9f0f4, #f3f6f9); }
  .tone-aasta-lifespace { --t-bg: linear-gradient(160deg, #f3ece0, #f8f4ec); }
  .tone-plant-os { --t-bg: linear-gradient(160deg, #13243a, #0a1524); }
  .tone-lead-engine { --t-bg: linear-gradient(160deg, #1c3f66, #122c4b); }

  .body { display: grid; gap: 8px; align-content: start; grid-template-rows: auto auto 1fr auto; padding: clamp(18px, 2vw, 24px); }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; }
  .kind { font-family: var(--font-head); font-size: 11.5px; font-weight: 680; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-ink); }
  .name { font-family: var(--font-display); font-size: clamp(1.5rem, 2.2vw, 1.85rem); font-weight: 480; letter-spacing: -0.024em; line-height: 1.1; color: var(--navy-700); }
  .tagline { font-size: 15px; line-height: 1.5; max-width: 48ch; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 10px; padding-top: 14px; border-top: 1px solid var(--line); }
  .for { font-size: 13.5px; line-height: 1.4; color: var(--slate-light); }
  .more { flex: none; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-head); font-size: 14px; font-weight: 640; color: var(--navy-700); white-space: nowrap; }
  .more :global(svg) { width: 16px; height: 16px; color: var(--gold-ink); transition: transform 0.25s ease; }
  .wcard:hover .more :global(svg) { transform: translateX(4px); }
  .wcard:hover .name { color: var(--navy-600); }

  /* the Lead Desk illustration has a fixed layout: shrink it so narrow cards show its full width */
  @media (max-width: 1100px) { .tone-lead-engine .thumb > :global(*) { zoom: 0.78; } }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
